\begin_layout Plain Layout

def dag( Q ):
\end_layout

\begin_layout Plain Layout

    '''Calculates the Hermitian adjoint of a quantum object
\end_layout

\begin_layout Plain Layout

       (vector or operator).
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    Args:
\end_layout

\begin_layout Plain Layout

      qobj:
 an numpy.ndarray representing a operator,
 bra,
\end_layout

\begin_layout Plain Layout

            or ket.
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    Returns:
\end_layout

\begin_layout Plain Layout

      The Hermitian adjoint of Q.
\end_layout

\begin_layout Plain Layout

    
\end_layout

\begin_layout Plain Layout

    '''
\end_layout

\begin_layout Plain Layout

    
\end_layout

\begin_layout Plain Layout

    return np.conj( Q.transpose() )
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Constants
\end_layout

\begin_layout Plain Layout

ket0 = np.array([[1],[0]],
 dtype='complex');
\end_layout

\begin_layout Plain Layout

ket1 = np.array([[0],[1]],
 dtype='complex');
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

X = np.array([[0,
 1],
 [1,
 0]],
 dtype='complex');
\end_layout

\begin_layout Plain Layout

Z = np.array([[1,
 0],
 [0,
 -1]],
 dtype='complex');
\end_layout

\begin_layout Plain Layout

hbar = 6.582E-16 # [eV*s] Planck's constant (reduced)
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Parameters
\end_layout

\begin_layout Plain Layout

gamma = 0.05 # [eV] tunneling energy
\end_layout

\begin_layout Plain Layout

T = np.pi*hbar/gamma # [s] time scale
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Initial state
\end_layout

\begin_layout Plain Layout

psi0 = ket0
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

nt = 75 # number of time points
\end_layout

\begin_layout Plain Layout

t = np.linspace(0,
 3*T,
 nt) # time vector
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Calculations
\end_layout

\begin_layout Plain Layout

H = -gamma*X # [eV] Hamiltonian
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Storage vector
\end_layout

\begin_layout Plain Layout

Pt = np.zeros((nt,)) # polarization in time
\end_layout

\begin_layout Plain Layout

Et = np.zeros((nt,)) # [eV] energy in time
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

for tidx,
 tval in enumerate(t):
\end_layout

\begin_layout Plain Layout

    # Time-dependent state
\end_layout

\begin_layout Plain Layout

    psit = expm( - 1j*tval*H/hbar ) @ psi0
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

	# calculate polarization
\end_layout

\begin_layout Plain Layout

    Pt[tidx] = -np.real( dag(psit) @ Z @ psit )[0,0]
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    # calculate energy expectation value
\end_layout

\begin_layout Plain Layout

    Et[tidx] = np.real( dag(psit) @ H @ psit )[0,0]
\end_layout

