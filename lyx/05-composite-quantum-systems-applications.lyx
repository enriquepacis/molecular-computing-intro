\begin_inset Formula 
\[
\hat{H}=\hat{H}_{\text{free}}+\hat{H}_{\text{int}}=\left[\begin{array}{cccc}
\frac{\Delta}{2}+\frac{E_{k}}{2} & -\gamma & -\gamma & 0\\
-\gamma & -\frac{\Delta}{2}-\frac{E_{k}}{2} & 0 & -\gamma\\
-\gamma & 0 & \frac{\Delta}{2}-\frac{E_{k}}{2} & -\gamma\\
0 & -\gamma & -\gamma & -\frac{\Delta}{2}+\frac{E_{k}}{2}
\end{array}\right]
\]

\end_inset

