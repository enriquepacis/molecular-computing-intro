\begin_layout Plain Layout
\noindent
The interaction term,
\end_layout

\begin_layout Plain Layout
\begin_inset Formula 
\[
\hat{H}_{\text{int}}=-\frac{E_{k}}{2}\hat{\sigma}_{z}^{(2)}\otimes\hat{\sigma}_{z}^{(1)}\otimes\hat{1}_{0}-\frac{E_{k}}{2}\hat{1}_{2}\otimes\hat{\sigma}_{z}^{(1)}\otimes\hat{\sigma}_{z}^{(0)}
\]

\end_inset

contributes 
\begin_inset Formula $E_{k}/2$
\end_inset

 for each kink and 
\begin_inset Formula $-E_{k}/2$
\end_inset

 for each antialignment:
\begin_inset Formula 
\[
\hat{H}_{\text{int}}=\left[\begin{array}{cccccccc}
E_{k}\\
 & 0\\
 &  & -E_{k}\\
 &  &  & 0\\
 &  &  &  & 0\\
 &  &  &  &  & -E_{k}\\
 &  &  &  &  &  & 0\\
 &  &  &  &  &  &  & E_{k}
\end{array}\right]
\]

\end_inset

Thus,
 the total Hamiltonian is
\begin_inset Formula 
\[
\hat{H}=\hat{H}_{\text{free}}+\hat{H}_{\text{int}}=\left[\begin{array}{cccccccc}
-\frac{3\Delta}{2}+E_{k}\\
 & -\frac{\Delta}{2}\\
 &  & -\frac{\Delta}{2}-E_{k}\\
 &  &  & \frac{\Delta}{2}\\
 &  &  &  & -\frac{\Delta}{2}\\
 &  &  &  &  & \frac{\Delta}{2}-E_{k}\\
 &  &  &  &  &  & \frac{\Delta}{2}\\
 &  &  &  &  &  &  & \frac{3\Delta}{2}+E_{k}
\end{array}\right]
\]

\end_inset

Thus,
 when 
\begin_inset Formula $\Delta$
\end_inset

 is small,
 we expect the ground state to be
\begin_inset Formula 
\[
\frac{1}{2}\left(\ket{010}+\ket{101}\right),
\]

\end_inset

which makes sense:
 the cells tend to antialign.
\end_layout

\begin_layout Plain Layout
When 
\begin_inset Formula $\Delta>0$
\end_inset

 is non-zero,
 
\begin_inset Formula $\ket{010}$
\end_inset

 remains the lowest state as long as 
\begin_inset Formula $\Delta$
\end_inset

 is small.
 There may come a time when state 
\begin_inset Formula $\ket{000}$
\end_inset

 with energy 
\begin_inset Formula $-3\Delta/2+E_{k}$
\end_inset

 is lower than 
\begin_inset Formula $-\Delta/2-E_{k}$
\end_inset

:
\begin_inset Formula 
\[
-\frac{3\Delta}{2}+E_{k}<-\frac{\Delta}{2}-E_{k},
\]

\end_inset

which leads us to
\begin_inset Formula 
\[
-\frac{\Delta}{2}<-E_{k}\qquad\rightarrow\qquad\Delta>2E_{k}.
\]

\end_inset

