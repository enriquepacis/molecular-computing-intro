\begin_layout Section
Time Evolution of a Composite System (Quantum Mechanics)
\end_layout

\begin_layout Subsection
Product Initial State
\end_layout

\begin_layout Itemize
Let systems 
\begin_inset Formula $A$
\end_inset

 and 
\begin_inset Formula $B$
\end_inset

,
 of Hilbert spaces 
\begin_inset Formula $\mathcal{H}_{A}$
\end_inset

 and 
\begin_inset Formula $\mathcal{H}_{B}$
\end_inset

,
 respectively,
 have initial states 
\begin_inset Formula $\ket{\psi_{A}}$
\end_inset

 and 
\begin_inset Formula $\ket{\psi_{B}}$
\end_inset


\end_layout

\begin_layout Itemize
We can form a product initial state,
 
\begin_inset Formula $\ket{\Psi\left(0\right)}=\ket{\psi_{B}}\ket{\psi_{A}}$
\end_inset


\end_layout

\begin_layout Itemize
The time dependent state 
\begin_inset Formula $\ket{\Psi\left(t\right)}$
\end_inset

 will be
\begin_inset Formula 
\[
\ket{\Psi\left(t\right)}=\hat{U}\left(t\right)\ket{\Psi\left(0\right)}.
\]

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
The composite system undergoes unitary dynamics,
 and 
\begin_inset Formula $\hat{\rho}\left(t\right)$
\end_inset

 remains pure
\end_layout

\begin_layout Itemize
The subsystems 
\begin_inset Formula $A$
\end_inset

 and 
\begin_inset Formula $B$
\end_inset

 do not undergo unitary dynamics.
 Generally:
\end_layout

\begin_deeper
\begin_layout Itemize
although initially pure,
 
\begin_inset Formula $A$
\end_inset

 and 
\begin_inset Formula $B$
\end_inset

,
 do not remain pure
\end_layout

\begin_layout Itemize
\begin_inset Formula $A$
\end_inset

 and 
\begin_inset Formula $B$
\end_inset

 become entangled in time
\end_layout

\begin_layout Itemize
there does not exist 
\begin_inset Formula $\ket{\psi_{A}\left(t\right)}$
\end_inset

 and 
\begin_inset Formula $\ket{\psi_{B}\left(t\right)}$
\end_inset

 such that 
\begin_inset Formula $\ket{\Psi\left(t\right)}=\ket{\psi_{B}\left(t\right)}\ket{\psi_{A}\left(t\right)}$
\end_inset


\end_layout

\end_deeper
\end_deeper
\begin_layout Itemize
Let 
\begin_inset Formula $A$
\end_inset

 and 
\begin_inset Formula $B$
\end_inset

 have an orthonormal bases 
\begin_inset Formula $\left\{ \ket{a}\right\} $
\end_inset

 and 
\begin_inset Formula $\left\{ \ket{b}\right\} $
\end_inset

,
 respectively:
\begin_inset Formula 
\[
\ket{\psi_{A}}=\sum_{a}\alpha_{a}\ket{a}\qquad\text{and}\qquad\ket{\psi_{B}}=\sum_{b}\beta_{b}\ket{b}
\]

\end_inset


\end_layout

\begin_layout Itemize
Then we can write the product state 
\begin_inset Formula $\ket{\Psi}$
\end_inset

 as:
\begin_inset Formula 
\begin{equation}
\ket{\Psi}=\sum_{b,a}\beta_{b}\alpha_{a}\ket{b}\ket{a}\label{eq:PsiProduct}
\end{equation}

\end_inset

and
\begin_inset Formula 
\[
\hat{\rho}\left(0\right)=\Ket{\Psi}\Bra{\Psi}=\sum_{b,b^{\prime},a,a^{\prime}}\beta_{b}\alpha_{a}\beta_{b^{\prime}}^{\ast}\alpha_{a^{\prime}}^{\ast}\ket{b}\ket{a}\bra{a^{\prime}}\bra{b^{\prime}}
\]

\end_inset


\end_layout

\begin_layout Itemize
At some 
\begin_inset Formula $t>0$
\end_inset

,
 we have
\begin_inset Formula 
\[
\hat{\rho}\left(t\right)=\sum_{b,b^{\prime},a,a^{\prime}}\rho_{c,c^{\prime}}\beta_{b}\left(t\right)\alpha_{a}\left(t\right)\beta_{b^{\prime}}^{\ast}\left(t\right)\alpha_{a^{\prime}}^{\ast}\left(t\right)\ket{b}\ket{a}\bra{a^{\prime}}\bra{b^{\prime}}
\]

\end_inset

with
\begin_inset Formula 
\[
\alpha_{a}\left(0\right)=\alpha_{a}\qquad\text{and}\qquad
\]

\end_inset


\end_layout

\begin_layout Itemize
Although 
\begin_inset Formula $\ket{\psi_{A}\left(t\right)}$
\end_inset

 does not exist,
 the best possible local description of system 
\begin_inset Formula $A$
\end_inset

 we can obtain is its reduced density operator,
 
\begin_inset Formula $\hat{\rho}_{A}^{\left(\text{r}\right)}$
\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
\begin_inset Formula $\hat{\rho}_{A}^{\left(\text{r}\right)}$
\end_inset

 is obtained by taking the partial trace of the full density operator 
\begin_inset Formula $\hat{\rho}$
\end_inset

 over an orthonormal basis,
 
\begin_inset Formula $\left\{ \ket{b}\right\} $
\end_inset

 of 
\begin_inset Formula $B$
\end_inset

:
\begin_inset Formula 
\begin{align*}
\hat{\rho}_{A}^{\left(\text{r}\right)}\left(t\right) & =\text{Tr}_{B}\hat{\rho}\left(t\right)=\sum_{b^{\prime\prime}}\braket{b^{\prime\prime}|\hat{\rho}\left(t\right)|b^{\prime\prime}}\\
 & =\sum_{b,b^{\prime},b^{\prime\prime},a,a^{\prime}}\beta_{b}\left(t\right)\alpha_{a}\left(t\right)\beta_{b^{\prime}}\left(t\right)\alpha_{a^{\prime}}\left(t\right)\braket{b^{\prime\prime}|b}\ket{a}\bra{a^{\prime}}\braket{b^{\prime}|b^{\prime\prime}}\\
 & =\sum_{b,a,a^{\prime}}\beta_{b}\left(t\right)\alpha_{a}\left(t\right)\beta_{b}^{\ast}\left(t\right)\alpha_{a^{\prime}}^{\ast}\left(t\right)\ket{a}\bra{a^{\prime}}\\
 & =\sum_{b,a,a^{\prime}}\left|\beta_{b}\left(t\right)\right|^{2}\alpha_{a}\left(t\right)\alpha_{a^{\prime}}^{\ast}\left(t\right)\ket{a}\bra{a^{\prime}}
\end{align*}

\end_inset


\end_layout

\begin_layout Itemize
Observations
\end_layout

\begin_deeper
\begin_layout Itemize
While 
\begin_inset Formula $\hat{\rho}$
\end_inset

 acts on the Hilbert space 
\begin_inset Formula $\mathcal{H}_{AB}$
\end_inset

,
 
\begin_inset Formula $\hat{\rho}_{A}^{\left(\text{r}\right)}$
\end_inset

 acts only on 
\begin_inset Formula $\mathcal{H}_{A}$
\end_inset


\end_layout

\begin_layout Itemize
Some information about system 
\begin_inset Formula $A$
\end_inset

 and all information about 
\begin_inset Formula $B$
\end_inset

 is discarded
\end_layout

\begin_deeper
\begin_layout Itemize
Only 
\begin_inset Formula $\left|\beta_{b}\left(t\right)\right|^{2}$
\end_inset

 is present in 
\begin_inset Formula $\hat{\rho}_{A}^{\left(\text{r}\right)}$
\end_inset

,
 not 
\begin_inset Formula $\beta_{b}\beta_{b^{\prime}}^{\ast}$
\end_inset

.
\end_layout

\end_deeper
\end_deeper
\end_deeper
\begin_layout Itemize
Similarly,
 we can obtain the best possible local description of 
\begin_inset Formula $B$
\end_inset

 by tracing over the basis 
\begin_inset Formula $\left\{ \ket{a}\right\} $
\end_inset

:
\begin_inset Formula 
\begin{align*}
\hat{\rho}_{B}^{\left(\text{r}\right)}\left(t\right) & =\text{Tr}_{B}\hat{\rho}\left(t\right)=\sum_{a^{\prime\prime}}\braket{a^{\prime\prime}|\hat{\rho}\left(t\right)|a^{\prime\prime}}\\
 & =\sum_{a,b,b^{\prime}}\left|\alpha_{a}\left(t\right)\right|^{2}\beta_{b}\left(t\right)\beta_{b^{\prime}}^{\ast}\left(t\right)\ket{b}\bra{b^{\prime}}
\end{align*}

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
Observations
\end_layout

\begin_deeper
\begin_layout Itemize
\begin_inset Formula $\hat{\rho}_{B}$
\end_inset

 acts only on 
\begin_inset Formula $\mathcal{H}_{B}$
\end_inset


\end_layout

\begin_layout Itemize
Some information about 
\begin_inset Formula $B$
\end_inset

 and all information about 
\begin_inset Formula $A$
\end_inset

 is discarded
\end_layout

\end_deeper
\end_deeper
\begin_layout Itemize
In general,
 we cannot reconstruct 
\begin_inset Formula $\hat{\rho}\left(t\right)$
\end_inset

 from 
\begin_inset Formula $\hat{\rho}_{A}^{\text{(r)}}\left(t\right)$
\end_inset

 and 
\begin_inset Formula $\hat{\rho}_{B}^{\text{(r)}}\left(t\right)$
\end_inset

,
 because we have discarded some information already:
\begin_inset Formula 
\[
\hat{\rho}\left(t\right)\neq\hat{\rho}_{B}^{\text{(r)}}\left(t\right)\otimes\hat{\rho}_{A}^{\text{(r)}}\left(t\right)
\]

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
In the special case that 
\begin_inset Formula $\hat{\rho}\left(t\right)$
\end_inset

 is a product:
\end_layout

\begin_deeper
\begin_layout Itemize
\begin_inset Formula $\hat{\rho}\left(t\right)=\hat{\rho}_{B}\left(t\right)\otimes\hat{\rho}_{A}\left(t\right)$
\end_inset


\end_layout

\begin_layout Itemize
\begin_inset Formula $\hat{\rho}_{B}^{\text{(r)}}\left(t\right)=\hat{\rho}_{B}\left(t\right)$
\end_inset

 and 
\begin_inset Formula $\hat{\rho}_{A}^{\text{(r)}}\left(t\right)=\hat{\rho}_{A}\left(t\right)$
\end_inset


\end_layout

\begin_layout Itemize
\begin_inset Formula $\hat{\rho}\left(t\right)=\hat{\rho}_{B}^{\text{(r)}}\left(t\right)\otimes\hat{\rho}_{A}^{\text{(r)}}\left(t\right)$
\end_inset


\end_layout

\end_deeper
\end_deeper
\begin_layout Itemize
From now on,
 we'll drop the superscript 
\begin_inset Formula $\left(\text{r}\right)$
\end_inset

 for simplicity.
\end_layout

