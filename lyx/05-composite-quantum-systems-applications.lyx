\begin_layout Plain Layout
Consider the general two-qubit state for qubits labeled 
\begin_inset Formula $B$
\end_inset

 and 
\begin_inset Formula $A$
\end_inset

:
\begin_inset Formula 
\[
\ket{\Psi}=c_{00}\ket{00}+c_{01}\ket{01}+c_{10}\ket{10}+c_{11}\ket{11},
\]

\end_inset

where 
\begin_inset Formula $\ket{\beta\alpha}=\ket{\beta_{B}}\ket{\alpha_{A}}$
\end_inset

.
\end_layout

\begin_layout Enumerate
Find the matrix representation 
\begin_inset Formula $\tilde{\rho}$
\end_inset

 for the density operator 
\begin_inset Formula $\hat{\rho}$
\end_inset

.
\begin_inset Newline newline
\end_inset

#+html:
 <details><summary>Show/hide solution...</summary>In braket notation,
 we have
\begin_inset Formula 
\[
\hat{\rho}=\sum_{\beta\alpha,\beta^{\prime}\alpha^{\prime}}c_{\beta\alpha}c_{\beta^{\prime}\alpha^{\prime}}^{\ast}\ket{\beta_{B}}\ket{\alpha_{A}}\bra{\alpha_{A}}\bra{\beta_{B}}
\]

\end_inset

Start with the vectors for 
\begin_inset Formula $\ket{\Psi}$
\end_inset

 and 
\begin_inset Formula $\Bra{\Psi}$
\end_inset

:
\begin_inset Formula 
\[
\ket{\Psi}\leftrightarrow\tilde{\Psi}=\left[\begin{array}{c}
c_{00}\\
c_{01}\\
c_{10}\\
c_{11}
\end{array}\right]\qquad\text{and}\qquad\bra{\Psi}\leftrightarrow\tilde{\Psi}^{\dagger}=\left[\begin{array}{cccc}
c_{00}^{\ast} & c_{01}^{\ast} & c_{10}^{\ast} & c_{11}^{\ast}\end{array}\right]
\]

\end_inset

Then,
 use matrix multiplication to find 
\begin_inset Formula $\tilde{\rho}$
\end_inset

:
\begin_inset Formula 
\[
\hat{\rho}=\ket{\Psi}\bra{\Psi}\leftrightarrow\tilde{\rho}=\left[\begin{array}{cccc}
c_{00}c_{00}^{\ast} & c_{00}c_{01}^{\ast} & c_{00}c_{10}^{\ast} & c_{00}c_{11}^{\ast}\\
c_{01}c_{00}^{\ast} & c_{01}c_{01}^{\ast} & c_{01}c_{10}^{\ast} & c_{01}c_{11}^{\ast}\\
c_{10}c_{00}^{\ast} & c_{10}c_{01}^{\ast} & c_{10}c_{10}^{\ast} & c_{10}c_{11}^{\ast}\\
c_{11}c_{00}^{\ast} & c_{11}c_{01}^{\ast} & c_{11}c_{10}^{\ast} & c_{11}c_{11}^{\ast}
\end{array}\right]
\]

\end_inset

#+html:
 </details>
\end_layout

\begin_layout Enumerate
Find the reduced density operators 
\begin_inset Formula $\hat{\rho}_{A}$
\end_inset

 and 
\begin_inset Formula $\hat{\rho}_{B}$
\end_inset

.
\begin_inset Newline newline
\end_inset

#+html:
 <details><summary>Show/hide solution...</summary>Start with 
\begin_inset Formula $\hat{\rho}_{A}$
\end_inset

:
\begin_inset Formula 
\[
\hat{\rho}_{A}=\text{Tr}_{B}\;\hat{\rho}=\sum_{\beta}\braket{\beta_{B}|\hat{\rho}|\beta_{B}}=\braket{0_{B}|\hat{\rho}|0_{B}}+\braket{1_{B}|\hat{\rho}|1_{B}}
\]

\end_inset

What are 
\begin_inset Formula $\braket{0_{B}|\hat{\rho}|0_{B}}$
\end_inset

 and 
\begin_inset Formula $\braket{1_{B}|\hat{\rho}|1_{B}}$
\end_inset

 in a matrix representation?
 
\begin_inset Formula $\braket{0_{B}|\hat{\rho}|0_{B}}$
\end_inset

 selects only those elements in 
\begin_inset Formula $\hat{\rho}$
\end_inset

 where 
\begin_inset Formula $c_{\beta\alpha}=c_{0\alpha}$
\end_inset

 and 
\begin_inset Formula $c_{\beta\alpha}^{\ast}=c_{0\alpha}^{\ast}$
\end_inset

.
 Thus:
\begin_inset Formula 
\[
\braket{0_{B}|\hat{\rho}|0_{B}}\leftrightarrow\left[\begin{array}{cc}
c_{00}c_{00}^{\ast} & c_{00}c_{01}^{\ast}\\
c_{01}c_{00}^{\ast} & c_{01}c_{01}^{\ast}
\end{array}\right]\qquad\text{and}\qquad\braket{1_{B}|\hat{\rho}|1_{B}}\leftrightarrow\left[\begin{array}{cc}
c_{10}c_{10}^{\ast} & c_{10}c_{11}^{\ast}\\
c_{11}c_{10}^{\ast} & c_{11}c_{11}^{\ast}
\end{array}\right]
\]

\end_inset


\begin_inset Formula 
\[
\tilde{\rho}_{A}=\left[\begin{array}{cc}
c_{00}c_{00}^{\ast}+c_{10}c_{10}^{\ast} & c_{00}c_{01}^{\ast}+c_{10}c_{11}^{\ast}\\
c_{01}c_{00}^{\ast}+c_{11}c_{10}^{\ast} & c_{01}c_{01}^{\ast}+c_{11}c_{11}^{\ast}
\end{array}\right]
\]

\end_inset

Now,
 calculate 
\begin_inset Formula $\hat{\rho}_{B}$
\end_inset

:
\begin_inset Formula 
\[
\hat{\rho}_{B}=\text{Tr}_{A}\;\hat{\rho}=\sum_{\alpha}\braket{\alpha_{A}|\hat{\rho}|\alpha_{A}}=\braket{0_{A}|\hat{\rho}|0_{A}}+\braket{1_{A}|\hat{\rho}|1_{A}}
\]

\end_inset

 
\begin_inset Formula 
\[
\braket{0_{A}|\hat{\rho}|0_{A}}\leftrightarrow\left[\begin{array}{cc}
c_{00}c_{00}^{\ast} & c_{00}c_{10}^{\ast}\\
c_{10}c_{00}^{\ast} & c_{10}c_{10}^{\ast}
\end{array}\right]\qquad\text{and}\qquad\braket{1_{A}|\hat{\rho}|1_{A}}\leftrightarrow\left[\begin{array}{cc}
c_{01}c_{01}^{\ast} & c_{01}c_{11}^{\ast}\\
c_{11}c_{01}^{\ast} & c_{11}c_{11}^{\ast}
\end{array}\right]
\]

\end_inset

and
\begin_inset Formula 
\[
\tilde{\rho}_{B}=\left[\begin{array}{cc}
c_{00}c_{00}^{\ast}+c_{01}c_{01}^{\ast} & c_{00}c_{10}^{\ast}+c_{01}c_{11}^{\ast}\\
c_{10}c_{00}^{\ast}+c_{11}c_{01}^{\ast} & c_{01}c_{10}^{\ast}+c_{11}c_{11}^{\ast}
\end{array}\right]
\]

\end_inset

