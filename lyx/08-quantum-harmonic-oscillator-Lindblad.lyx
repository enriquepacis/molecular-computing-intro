\end_layout

\begin_layout Plain Layout

# Quantum Liouville evolution    
\end_layout

\begin_layout Plain Layout

from odeintw import odeintw
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

rho0 = la.density_matrix(psi0) # form a density operator
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Integrate the solution
\end_layout

\begin_layout Plain Layout

# odeintw produces an array sol
\end_layout

\begin_layout Plain Layout

#   Each element of sol is the density matrix at a
\end_layout

\begin_layout Plain Layout

#   particular time
\end_layout

\begin_layout Plain Layout

# Extract expectation values after calling odeintw
\end_layout

\begin_layout Plain Layout

sol = odeintw(quantum_liouville,
 rho0,
 t,
 args=(qosc.H,) )
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

PDE_liou = np.zeros([N,
 nt])
\end_layout

\begin_layout Plain Layout

PDX_liou = np.zeros([N,
 nt])
\end_layout

\begin_layout Plain Layout

Et_liou = np.zeros((nt,))
\end_layout

\begin_layout Plain Layout

Xt_liou = np.zeros((nt,))
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

for it in range(nt):
\end_layout

\begin_layout Plain Layout

    PDE_liou[:,it] = np.diag(sol[it]).real
\end_layout

\begin_layout Plain Layout

    rhoX = qosc.change_basis(sol[it],
 fr='energy',
 to='position')
\end_layout

\begin_layout Plain Layout

    PDX_liou[:,it] = np.diag(rhoX).real
\end_layout

\begin_layout Plain Layout

    Et_liou[it] = la.expectation_value( qosc.H,
 sol[it],
 validate=False )
\end_layout

\begin_layout Plain Layout

    Xt_liou[it] = la.expectation_value( qosc.X,
 sol[it],
 validate=False )
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    
\end_layout

\begin_layout Plain Layout

