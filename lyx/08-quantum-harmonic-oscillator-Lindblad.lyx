\begin_layout Plain Layout

from qcapackage.quantum.timeevolution import quantum_liouville,
 lindblad
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# select the initial state
\end_layout

\begin_layout Plain Layout

start = 'coherent'
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

N = 15
\end_layout

\begin_layout Plain Layout

nt = 500
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Create a QHO object
\end_layout

\begin_layout Plain Layout

# Uses default m = 6 amu and f = 300 inv cm
\end_layout

\begin_layout Plain Layout

qosc = QHO(N=N)
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

X0 = qosc.Q0 # [nm] characteristic length
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

T = qosc.T # [s] oscillation period
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Form Lindblad operators
\end_layout

\begin_layout Plain Layout

#   The relaxation time is chosen to be 2*T
\end_layout

\begin_layout Plain Layout

qosc.make_lindblad_operators( 2*T,
 type='relaxation' )
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

t = np.linspace(0,
 8*T,
 nt).flatten()
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Storage arrays
\end_layout

\begin_layout Plain Layout

PDE = np.zeros([N,
 nt]) # prob dist over energy
\end_layout

\begin_layout Plain Layout

PDX = np.zeros([N,
 nt]) # prob dist over position
\end_layout

\begin_layout Plain Layout

Et = np.zeros((nt,))
\end_layout

\begin_layout Plain Layout

Xt = np.zeros((nt,))
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Prepare the initial state
\end_layout

\begin_layout Plain Layout

if start == 'eigenstate':
\end_layout

\begin_layout Plain Layout

    psi0 = qosc.energy_state(0)
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

elif start == 'coherent':
\end_layout

\begin_layout Plain Layout

    d = 1 + 1j # displacement
\end_layout

\begin_layout Plain Layout

    D = qosc.displacement_operator(d)
\end_layout

\begin_layout Plain Layout

    # Recall that D|0> "selects" the first column of D
\end_layout

\begin_layout Plain Layout

    psi0 = D @ qosc.energy_state(0)
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

elif start == 'arbitrary':
\end_layout

\begin_layout Plain Layout

    psi0 = la.normalize( qosc.energy_state(1) + qosc.energy_state(2) )
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Exponential time evolution
\end_layout

\begin_layout Plain Layout

for it,
 tt in enumerate(t):
\end_layout

\begin_layout Plain Layout

    Ut = sp.linalg.expm(-1j * qosc.H * tt / const.hbar )
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    psit = Ut @ psi0
\end_layout

\begin_layout Plain Layout

    psitX = qosc.change_basis(psit,
 fr='energy',
 to='position')
\end_layout

\begin_layout Plain Layout

    
\end_layout

\begin_layout Plain Layout

    PDE[:,it] = la.state_to_probability(psit).real
\end_layout

\begin_layout Plain Layout

    PDX[:,it] = la.state_to_probability(psitX).real
\end_layout

\begin_layout Plain Layout

    Et[it] = la.expectation_value( qosc.H,
 psit,
 validate=False )
\end_layout

\begin_layout Plain Layout

    Xt[it] = la.expectation_value( qosc.X,
 psit,
 validate=False )
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

fig,
 ax = plt.subplots( 2,
 1 )
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

tt,
 xx = np.meshgrid(t.flatten()/qosc.T,
 qosc.Xval,
 indexing='xy')
\end_layout

\begin_layout Plain Layout

_,
 EE = np.meshgrid(t.flatten()/T,
 qosc.Eval/qosc.hw,
 indexing='xy')
\end_layout

\begin_layout Plain Layout

\end_layout

