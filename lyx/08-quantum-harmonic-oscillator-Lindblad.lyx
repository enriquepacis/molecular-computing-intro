\begin_layout Standard
\begin_inset Note Note
status open

\begin_layout Plain Layout
A thermal harmonic oscillator should satisfy
\begin_inset Formula 
\begin{equation}
p_{n}\propto e^{-E_{n}/k_{B}T}\label{eq:thermal-probability-oscillator-Pn}
\end{equation}

\end_inset

with
\begin_inset Formula 
\[
E_{n}=\hbar\omega\left(n+\frac{1}{2}\right)
\]

\end_inset


\end_layout

\begin_layout Itemize
If we take the logarithm of 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:thermal-probability-oscillator-Pn"

\end_inset

,
 we get
\begin_inset Formula 
\begin{align*}
\ln p_{n} & =-\frac{E_{n}}{k_{B}T}+\text{const.}=-\frac{\hbar\omega}{k_{B}T}n+\frac{\hbar\omega}{2}+\text{const.}\\
 & =-\frac{\hbar\omega}{k_{B}T}n+\text{const.}
\end{align*}

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
Thus,
 a thermal state should appear as a straight line on a semilog plot of population versus quantum number 
\begin_inset Formula $n$
\end_inset

.
\end_layout

\end_deeper
\end_inset


\end_layout

