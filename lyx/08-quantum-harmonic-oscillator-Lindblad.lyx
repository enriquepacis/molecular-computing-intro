\begin_layout Subsection
Lindblad Evolution:
 steady-state Behaviors
\end_layout

\begin_layout Itemize
It may not be evident how the dynamics of dissipation (relaxation) differ from thermalization
\end_layout

\begin_deeper
\begin_layout Itemize
After all,
 Figures 
\begin_inset CommandInset ref
LatexCommand ref
reference "fig:qho-dynamics-2-1"

\end_inset

 and 
\begin_inset CommandInset ref
LatexCommand ref
reference "fig:qho-dynamics-3-1"

\end_inset

 are very similar to Figures 
\begin_inset CommandInset ref
LatexCommand ref
reference "fig:qho-dynamics-2-1-1"

\end_inset

 and 
\begin_inset CommandInset ref
LatexCommand ref
reference "fig:qho-dynamics-3-1-1"

\end_inset

.
\end_layout

\end_deeper
\begin_layout Itemize
It may be more useful to compare steady-state behaviors
\end_layout

\begin_deeper
\begin_layout Itemize
This is the result of applying the Lindblad operators for a long time,
 so that 
\begin_inset Formula $d\rho/dt\rightarrow0$
\end_inset

,
 that is,
 we get an unchanging 
\begin_inset Formula $\hat{\rho}\left(t\right)$
\end_inset


\end_layout

\begin_layout Itemize
Thus,
 we would like to solve for the steady-state 
\begin_inset Formula $\rho_{\text{ss}}$
\end_inset

 that solves
\begin_inset Formula 
\[
\frac{d\rho}{dt}=-\frac{i}{\hbar}\left[\hat{H},\hat{\rho}\right]+\sum_{j}\hat{L}_{j}\hat{\rho}\hat{L}_{j}^{\dagger}-\frac{1}{2}\left\{ \hat{L}_{j}^{\dagger}\hat{L}_{j},\hat{\rho}\right\} =0
\]

\end_inset


\end_layout

\end_deeper
\begin_layout Itemize
The Python 
\begin_inset listings
lstparams "basicstyle={\ttfamily}"
inline true
status open

\begin_layout Plain Layout

qutip
\end_layout

\end_inset

 package can calculate Lindblad dynamics,
 as well as steady-state density matrices
\end_layout

\begin_layout Itemize
Some notes on using 
\begin_inset listings
lstparams "basicstyle={\ttfamily}"
inline true
status open

\begin_layout Plain Layout

qutip
\end_layout

\end_inset

 to solve the Lindblad equation
\end_layout

\begin_deeper
\begin_layout Itemize
\begin_inset listings
lstparams "basicstyle={\ttfamily}"
inline true
status open

\begin_layout Plain Layout

qutip
\end_layout

\end_inset

 provides a class,
 
\begin_inset listings
lstparams "basicstyle={\ttfamily}"
inline true
status open

\begin_layout Plain Layout

qutip.Qobj
\end_layout

\end_inset

,
 which is used to describe quantum objects such as kets and operators
\end_layout

\begin_layout Itemize
Use the 
\begin_inset listings
lstparams "basicstyle={\ttfamily}"
inline true
status open

\begin_layout Plain Layout

mesolve()
\end_layout

\end_inset

 function to describe and solve a Lindblad evolution in time
\end_layout

\begin_deeper
\begin_layout Itemize
\begin_inset listings
lstparams "basicstyle={\ttfamily}"
inline true
status open

\begin_layout Plain Layout

mesolve
\end_layout

\end_inset

 is short for 
\begin_inset Quotes eld
\end_inset

master equation solve,
\begin_inset Quotes erd
\end_inset

 because the Lindblad equation is known as a 
\series bold
master equation
\end_layout

\begin_layout Itemize
The syntax for using 
\begin_inset listings
lstparams "basicstyle={\ttfamily}"
inline true
status open

\begin_layout Plain Layout

mesolve
\end_layout

\end_inset

 is
\begin_inset listings
lstparams "language=Python,basicstyle={\ttfamily}"
inline false
status open

\begin_layout Plain Layout

result = mesolve(
\end_layout

\begin_layout Plain Layout

    H,
    # qutip.Qobj,
 Hamiltonian operator
\end_layout

\begin_layout Plain Layout

    rho0,
 # qutip.Qobj,
 initial density operator
\end_layout

\begin_layout Plain Layout

    t,
    # numpy time vector for the evolution
\end_layout

\begin_layout Plain Layout

    c_ops=c_ops,
 # list of Lindblad operators (collapse operators,
 qutip.Qobj)
\end_layout

\begin_layout Plain Layout

    e_ops=e_ops # list of measurement operators (expectation values desired,
 qutip.Qobj)
\end_layout

\begin_layout Plain Layout

)
\end_layout

\end_inset


\end_layout

\begin_layout Itemize
\begin_inset listings
lstparams "basicstyle={\ttfamily}"
inline true
status open

\begin_layout Plain Layout

mesolve
\end_layout

\end_inset

 uses natural units,
 where 
\begin_inset Formula $\hbar=1$
\end_inset

:
\begin_inset Formula 
\[
\frac{d\rho}{dt}=-i\left[\hat{H},\hat{\rho}\right]+\sum_{j}\hat{L}_{j}\hat{\rho}\hat{L}_{j}^{\dagger}-\frac{1}{2}\left\{ \hat{L}_{j}^{\dagger}\hat{L}_{j},\hat{\rho}\right\} =0
\]

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
Here,
 
\begin_inset Formula $\hat{H}$
\end_inset

 has units of not eV,
 but rather eV/
\begin_inset Formula $\hbar$
\end_inset

.
 Thus,
 instead of using 
\begin_inset Formula $\hat{H}=\hbar\omega\left(\hat{a}^{\dagger}\hat{a}+\hat{1}/2\right)$
\end_inset

 for the Hamiltonian,
 we use 
\begin_inset Formula $\hat{H}=\omega\left(\hat{a}^{\dagger}\hat{a}+\hat{1}/2\right)$
\end_inset


\end_layout

\end_deeper
\end_deeper
