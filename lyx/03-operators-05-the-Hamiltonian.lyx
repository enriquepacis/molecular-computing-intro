\begin_layout Subsection
Expectation Values
\end_layout

\begin_layout Itemize
Let an operator 
\begin_inset Formula $\mathbf{Q}$
\end_inset

 describes an observable quantity,
 and let 
\begin_inset Formula $\mathbf{Q}$
\end_inset

 have eigenvalues 
\begin_inset Formula $q$
\end_inset

 with associated eigenstates 
\begin_inset Formula $\ket{q}$
\end_inset

:
 
\begin_inset Formula 
\begin{equation}
\mathbf{Q}\ket{q}=q\ket{q}\label{eq:ObservableEigenvalue}
\end{equation}

\end_inset


\end_layout

\begin_layout Itemize
The eigenvalues 
\begin_inset Formula $\left\{ q\right\} $
\end_inset

 are the only possible results of a measurement
\end_layout

\begin_deeper
\begin_layout Itemize
Since 
\begin_inset Formula $\mathbf{Q}$
\end_inset

 describes a measurement,
 the possible measured values must be real
\end_layout

\begin_layout Itemize
Thus,
 the eigenvalues of 
\begin_inset Formula $\mathbf{Q}$
\end_inset

 must be real quantities
\end_layout

\end_deeper
\begin_layout Itemize
If the eigenvalues 
\begin_inset Formula $\left\{ q\right\} $
\end_inset

 of observable 
\begin_inset Formula $\mathbf{Q}$
\end_inset

 are unique,
 then the eigenstates 
\begin_inset Formula $\left\{ \ket{q}\right\} $
\end_inset

 form an orthonormal basis for the Hilbert space 
\begin_inset Formula $\mathcal{H}$
\end_inset

 of our quantum system:
\begin_inset Formula 
\begin{equation}
\braket{q|q^{\prime}}=\delta_{q,q^{\prime}}=\begin{cases}
1, & q=q^{\prime}\\
0, & q\neq q^{\prime}
\end{cases}\label{eq:KroneckerDeltaObservable}
\end{equation}

\end_inset


\end_layout

\begin_layout Itemize
An arbitrary state 
\begin_inset Formula $\ket{\psi}$
\end_inset

 may be expanded over the eigenbasis 
\begin_inset Formula $\left\{ \ket{q}\right\} $
\end_inset

 as
\begin_inset Formula 
\begin{equation}
\ket{\psi}=\sum_{q}c_{q}\ket{q},\label{eq:AribtrarySuperpositionEigenbasisO}
\end{equation}

\end_inset

where 
\begin_inset Formula 
\[
c_{q}=\braket{q|\psi}
\]

\end_inset

 are amplitudes,
 and the probability for measuring 
\begin_inset Formula $q$
\end_inset

 is given by
\begin_inset Formula 
\begin{equation}
p\left(q\right)=\left|c_{q}\right|^{2}=c_{q}^{\ast}c_{q}\label{eq:MeasurementProbability}
\end{equation}

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
Thus,
 for physically meaningful probabilities,
 we require normalization
\begin_inset Formula 
\[
\sum_{q}p\left(q\right)=\sum_{q}c_{q}^{\ast}c_{q}=1
\]

\end_inset


\end_layout

\end_deeper
\begin_layout Itemize
Given a state 
\begin_inset Formula $\ket{\psi}$
\end_inset

,
 the expectation value of 
\begin_inset Formula $\mathbf{Q}$
\end_inset

 is defined as
\begin_inset Formula 
\begin{equation}
\braket{\mathbf{Q}}=\braket{\psi|\mathbf{Q}|\psi}\label{eq:ExpectationValueStateVector}
\end{equation}

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
Expand this using Equation
\begin_inset Formula 
\begin{align*}
\braket{\mathbf{Q}} & =\left(\sum_{q^{\prime}}c_{q^{\prime}}^{\ast}\bra{q^{\prime}}\right)\mathbf{Q}\left(\sum_{q}c_{q}\bra{q}\right)\\
 & =\sum_{q,q^{\prime}}c_{q^{\prime}}^{\ast}c_{q}\braket{q^{\prime}|\mathbf{Q}|q}\\
 & =\sum_{q,q^{\prime}}c_{q^{\prime}}^{\ast}c_{q}q\braket{q^{\prime}|q}\\
 & =\sum_{q,q^{\prime}}c_{q^{\prime}}^{\ast}c_{q}q\delta_{q^{\prime},q}\\
 & =\sum_{q}c_{q}^{\ast}c_{q}q=\sum_{q}p\left(q\right)q
\end{align*}

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
Here,
 we used 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:ObservableEigenvalue"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

,
 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:KroneckerDeltaObservable"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

,
 and 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:MeasurementProbability"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset


\end_layout

\end_deeper
\end_deeper
\begin_layout Itemize
The astute reader will understand what is happening here:
\end_layout

\begin_deeper
\begin_layout Itemize
\begin_inset Formula $\braket{\mathbf{Q}}$
\end_inset

 is the weighted sum of measurement outcomes,
 
\begin_inset Formula $\left\{ q\right\} $
\end_inset


\end_layout

\begin_layout Itemize
Each outcome is weighted by its probability of measurement
\end_layout

\begin_layout Itemize
Thus,
 we interpret 
\begin_inset Formula $\braket{\mathbf{Q}}$
\end_inset

 as the mean value of measurement outcomes for a large ensemble of measurements
\end_layout

\begin_deeper
\begin_layout Itemize
Another name for 
\begin_inset Formula $\braket{\mathbf{Q}}$
\end_inset

 is the 
\series bold
expected value
\series default
 (you might recall this from your class on probability and statistics)
\end_layout

\begin_layout Itemize
In quantum mechanics,
 we call 
\begin_inset Formula $\braket{\mathbf{Q}}$
\end_inset

 the 
\series bold
expectation value
\series default
 of 
\begin_inset Formula $\mathbf{Q}$
\end_inset

 given 
\begin_inset Formula $\ket{\psi}$
\end_inset

,
 or simply the expectation value of 
\begin_inset Formula $\mathbf{Q}$
\end_inset


\end_layout

\end_deeper
\end_deeper
