\begin_layout Plain Layout
#+html:
 <details><summary>Show/hide solution...</summary>
\end_layout

\begin_layout Plain Layout
The graphic from our solution is shown in Figure ,
 computed using the code of Listing .
 The QCA cell insets were plotted using the 
\begin_inset listings
lstparams "language=Matlab,basicstyle={\ttfamily}"
inline true
status open

\begin_layout Plain Layout

drawDQD()
\end_layout

\end_inset

 function of Listing .
 We already know that 
\begin_inset Formula $P_{drv}=1$
\end_inset

 means that the mobile electron occupies dot 1 for the driver,
 and that 
\begin_inset Formula $P_{drv}=-1$
\end_inset

 means that the electron occupies dot 0 for the driver.
 What does a polarization 
\begin_inset Formula $-1<P_{drv}<1$
\end_inset

 mean?
 It means that the driver isn't in state 
\begin_inset Quotes eld
\end_inset

0
\begin_inset Quotes erd
\end_inset

 with absolute certainty,
 and neither is it in state 
\begin_inset Quotes eld
\end_inset

1
\begin_inset Quotes erd
\end_inset

 with absolute certainty.
 To calculate the effects of the driver cell charge on target cell,
 we make the mean-field approximation.
 This means that we assume that the overall electric field 
\begin_inset Formula $\mathbf{E}_{drv}\left(\mathbf{r}\right)$
\end_inset

 created from the driver is a combination of the fields created from the driver in state 
\begin_inset Quotes eld
\end_inset

0
\begin_inset Quotes erd
\end_inset

 and the driver in state 
\begin_inset Quotes eld
\end_inset

1
\begin_inset Quotes erd
\end_inset

,
 
\begin_inset Formula $\mathbf{E}_{drv}\left(\mathbf{r}\right)$
\end_inset

 and 
\begin_inset Formula $\mathbf{E}_{drv,1}\left(\mathbf{r}\right)$
\end_inset

:
\begin_inset Formula 
\[
\mathbf{E}_{drv}=p_{drv}\left(0\right)\mathbf{E}_{drv,0}\left(\mathbf{r}\right)+p_{drv}\left(1\right)\mathbf{E}_{drv,1}\left(\mathbf{r}\right).
\]

\end_inset

The linear combination of fields for each state 
\begin_inset Formula $\alpha$
\end_inset

 is weighted by the probability 
\begin_inset Formula $p_{drv}\left(\alpha\right)$
\end_inset

.
 The rules of probability dictate that 
\begin_inset Formula $p_{drv}\left(0\right)+p_{drv}\left(1\right)=1$
\end_inset

,
 so we can eliminate,
 say,
 
\begin_inset Formula $p_{drv}\left(1\right)$
\end_inset

 and write
\begin_inset Formula 
\[
\mathbf{E}_{drv}=p_{drv}\left(0\right)\mathbf{E}_{drv,0}\left(\mathbf{r}\right)+\left(1-p_{drv}\left(0\right)\right)\mathbf{E}_{drv,1}\left(\mathbf{r}\right).
\]

\end_inset


\end_layout

\begin_layout Plain Layout
Recall that the potential energy between two charges 
\begin_inset Formula $q_{1}$
\end_inset

 and 
\begin_inset Formula $q_{2}$
\end_inset

 is given by
\begin_inset Formula 
\begin{equation}
U=q_{2}\mathbf{E}_{1}\left(\mathbf{r}_{2}\right)=\frac{q_{1}q_{2}}{4\pi\varepsilon_{0}\left|\mathbf{r}_{2}-\mathbf{r}_{1}\right|},\label{eq:ElectrostaticPotential}
\end{equation}

\end_inset

where 
\begin_inset Formula $\mathbf{r}_{1}$
\end_inset

 and 
\begin_inset Formula $\mathbf{r}_{2}$
\end_inset

 are the position of 
\begin_inset Formula $q_{1}$
\end_inset

 and 
\begin_inset Formula $q_{2}$
\end_inset

,
 respectively,
 and the field from charge 1 at some arbitrary point is
\begin_inset Formula 
\[
\mathbf{E}_{1}\left(\mathbf{r}\right)=\frac{q_{1}}{4\pi\varepsilon_{0}\left|\mathbf{r}_{1}-\mathbf{r}\right|}
\]

\end_inset

Now,
 let 
\begin_inset Formula $\mathbf{r}_{0}$
\end_inset

 and 
\begin_inset Formula $\mathbf{r}_{1}$
\end_inset

 be the positions of driver dots 0 and 1,
 and 
\begin_inset Formula $\mathbf{r}$
\end_inset

 be an arbitrary position.
 We can calculate the field at 
\begin_inset Formula $\mathbf{r}$
\end_inset

 due to the driver in the mean-field approximation:
\begin_inset Formula 
\begin{align*}
\mathbf{E}_{drv}\left(\mathbf{r}\right) & =p_{drv}\left(0\right)\mathbf{E}_{drv,0}\left(\mathbf{r}\right)+p_{drv}\left(1\right)\mathbf{E}_{drv,1}\left(\mathbf{r}\right)\\
 & =-\frac{p_{drv}\left(0\right)q_{e}}{4\pi\varepsilon_{0}\left|\mathbf{r}_{0}-\mathbf{r}\right|}-\frac{p_{drv}\left(1\right)q_{e}}{4\pi\varepsilon_{0}\left|\mathbf{r}_{1}-\mathbf{r}\right|}
\end{align*}

\end_inset

Here,
 we have negative signs because we're assuming we have a mobile driver electron of charge 
\begin_inset Formula $-q_{e}$
\end_inset

.
 In this mean-field approximation,
 we can treat 
\begin_inset Formula $-p_{drv}\left(0\right)q_{e}$
\end_inset

 and 
\begin_inset Formula $-p_{drv}\left(1\right)q_{e}$
\end_inset

 as effective fractional electrons residing on dots 0 and 1.
 In fact,
 we can write these as a function of the driver polarization.
 It can be shown that
\begin_inset Formula 
\[
p_{drv}\left(0\right)=\frac{1}{2}\left(1-P_{drv}\right)\qquad\text{and}\qquad p_{drv}\left(0\right)=\frac{1}{2}\left(1+P_{drv}\right)
\]

\end_inset

Now,
 we can write an effective mobile charge on each dot:
\begin_inset Formula 
\[
q_{0}=-\frac{1}{2}\left(1-P_{drv}\right)q_{e}\qquad\text{and}\qquad q_{1}=-\frac{1}{2}\left(1+P_{drv}\right)q_{e}.
\]

\end_inset

Next,
 we calculate the electrostatic potential 
\begin_inset Formula $U_{0}$
\end_inset

 of an electron on dot 0 of the target cell.
 The potential contribution 
\begin_inset Formula $U_{0,\text{fnc}}$
\end_inset

 from the two neutralizing charges of the driver cell are
\begin_inset Formula 
\[
U_{0,\text{fnc}}=\frac{q_{e}/2}{4\pi\varepsilon_{0}}\left(\frac{1}{a}\right)+\frac{q_{e}/2}{4\pi\varepsilon_{0}}\left(\frac{1}{a\sqrt{2}}\right)=\frac{q_{e}}{8\pi\varepsilon_{0}a}\left(1+\frac{1}{\sqrt{2}}\right)
\]

\end_inset

We must also calculate the electrostatic potential energy 
\begin_inset Formula $U_{0,\text{mc}}$
\end_inset

 for the electron on dot 0 of the target cell due to the mobile charge on both dots of the driver cell:
\begin_inset Formula 
\[
U_{0,\text{mc}}=\overbrace{\frac{q_{e}q_{o}}{4\pi\varepsilon_{0}}\left(\frac{1}{a}\right)}^{\text{driver cell, dot 0}}+\overbrace{\frac{q_{e}q_{1}}{4\pi\varepsilon_{0}}\left(\frac{1}{a\sqrt{2}}\right)}^{\text{driver cell, dot 1}}
\]

\end_inset

Thus,
 we can now write the 
\begin_inset Formula $\braket{0|\hat{H}|0}$
\end_inset

 term of the Hamiltonian:
\begin_inset Formula 
\[
\braket{0|\hat{H}|0}=U_{0,\text{fnc}}+U_{0,\text{mc}}
\]

\end_inset

We can repeat this analysis for 
\begin_inset Formula $\braket{1|\hat{H}|1}=U_{1,\text{fnc}}+U_{1,\text{mc}}$
\end_inset

.
 It can be shown that the potential energy on target cell dot 1 due to the fixed neutralizing charge is the same as the potential energy of the electron on dot zero:
\begin_inset Formula 
\begin{equation}
U_{1,\text{fnc}}=U_{0,\text{fnc}}.\label{eq:DQD_FNC_potential}
\end{equation}

\end_inset

Next,
 we calculate the potential energy 
\begin_inset Formula $U_{1,\text{mc}}$
\end_inset

 of the target cell electron to be on dot 1 of the target cell due to the mobile charge of the driver:
 
\begin_inset Formula 
\[
U_{1,\text{mc}}=\frac{\left(-q_{e}\right)q_{0}}{4\pi\varepsilon_{0}}\left(\frac{1}{a\sqrt{2}}\right)+\frac{\left(-q_{e}\right)q_{1}}{4\pi\varepsilon_{0}}\left(\frac{1}{a}\right)
\]

\end_inset

Thus,
 if we want to calculate 
\begin_inset Formula $\Delta,$
\end_inset

we have
\begin_inset Formula 
\begin{align}
\Delta & =\braket{1|\hat{H}|1}-\braket{0|\hat{H}|0}=\cancel{U_{1,\text{fnc}}}+U_{1,\text{mc}}-\cancel{U_{0,\text{fnc}}}-U_{0,\text{mc}}\nonumber \\
 & \stackrel{\left(\ref{eq:DQD_FNC_potential}\right)}{=}U_{1,\text{mc}}-U_{0,\text{mc}}\nonumber \\
 & =\frac{\left(-q_{e}\right)q_{0}}{4\pi\varepsilon_{0}}\left(\frac{1}{a\sqrt{2}}\right)+\frac{\left(-q_{e}\right)q_{1}}{4\pi\varepsilon_{0}}\left(\frac{1}{a}\right)-\frac{\left(-q_{e}\right)q_{o}}{4\pi\varepsilon_{0}}\left(\frac{1}{a}\right)-\frac{\left(-q_{e}\right)q_{1}}{4\pi\varepsilon_{0}}\left(\frac{1}{a\sqrt{2}}\right)\nonumber \\
 & =\frac{-q_{e}}{4\pi\varepsilon_{0}a}\left[q_{0}\left(\frac{1}{\sqrt{2}}-1\right)+q_{1}\left(1-\frac{1}{\sqrt{2}}\right)\right]\nonumber \\
 & =\frac{-q_{e}}{4\pi\varepsilon_{0}a}\left[q_{1}-q_{0}\right]\left(1-\frac{1}{\sqrt{2}}\right)\nonumber \\
 & =\frac{-q_{e}^{2}}{4\pi\varepsilon_{0}a}\left[\frac{1}{2}\left(\cancel{1}+P_{drv}\right)-\frac{1}{2}\left(\cancel{1}-P_{drv}\right)\right]\left(\frac{1}{\sqrt{2}}-1\right)\nonumber \\
 & =\frac{-q_{e}^{2}P_{drv}}{4\pi\varepsilon_{0}a}\left(\frac{1}{\sqrt{2}}-1\right)=\kappa P_{drv},\label{eq:Delta_Pdrv}
\end{align}

\end_inset

where 
\begin_inset Formula 
\begin{equation}
\kappa=-\left(\frac{1}{\sqrt{2}}-1\right)\frac{q_{e}^{2}}{4\pi\varepsilon_{0}a}=\left(1-\frac{1}{\sqrt{2}}\right)\frac{q_{e}^{2}}{4\pi\varepsilon_{0}a}.\label{eq:KinkGeometricConstant}
\end{equation}

\end_inset

Notice that everything in 
\begin_inset Formula $\kappa$
\end_inset

 is a physical or mathematical constant,
 save 
\begin_inset Formula $a$
\end_inset

.
 Thus,
 
\begin_inset Formula $a$
\end_inset

 determines the value of 
\begin_inset Formula $\kappa$
\end_inset

.
 We can now calculate 
\begin_inset Formula $\Delta$
\end_inset

 and target cell polarization,
 
\begin_inset Formula $P$
\end_inset

,
 as a function of 
\begin_inset Formula $P_{\text{drv}}$
\end_inset

,
 which we write only in terms of geometric and physical constants:
\begin_inset Formula 
\begin{equation}
\Delta\left(P_{\text{drv}}\right)=\left(1-\frac{1}{\sqrt{2}}\right)\frac{q_{e}^{2}}{4\pi\varepsilon_{0}a}P_{\text{drv}}.\label{eq:Delta_Pdrv_explicit}
\end{equation}

\end_inset


\end_layout

