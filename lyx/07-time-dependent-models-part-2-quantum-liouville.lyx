\begin_layout Plain Layout

def expectation_value( op,
 psi ):
\end_layout

\begin_layout Plain Layout

    """
\end_layout

\begin_layout Plain Layout

       Return the expectation value for an
\end_layout

\begin_layout Plain Layout

       operator op.
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

       Args
\end_layout

\begin_layout Plain Layout

         psi:
 a state vector or a density matrix
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

       Returns real expectation value
\end_layout

\begin_layout Plain Layout

    """
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    if psi.shape[0] == psi.shape[1]:
 # if psi is a density matrix
\end_layout

\begin_layout Plain Layout

        result = np.trace( op @ psi ).real
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    else:
 # if psi is a vector
\end_layout

\begin_layout Plain Layout

    
\end_layout

\begin_layout Plain Layout

        temp = dag( psi ) @ op @ psi
\end_layout

\begin_layout Plain Layout

        result = temp[0,0].real
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    return result
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

def dag( Q ):
\end_layout

\begin_layout Plain Layout

    '''Calculates the Hermitian adjoint of a quantum object
\end_layout

\begin_layout Plain Layout

       (vector or operator).
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    Args:
\end_layout

\begin_layout Plain Layout

      qobj:
 an numpy.ndarray representing a operator,
 bra,
\end_layout

\begin_layout Plain Layout

            or ket.
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    Returns:
\end_layout

\begin_layout Plain Layout

      The Hermitian adjoint of Q.
\end_layout

\begin_layout Plain Layout

    
\end_layout

\begin_layout Plain Layout

    '''
\end_layout

\begin_layout Plain Layout

    
\end_layout

\begin_layout Plain Layout

    return np.conj( Q.transpose() )
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

def commutator( A,
 B ):
\end_layout

\begin_layout Plain Layout

    """
\end_layout

\begin_layout Plain Layout

       Evaluates the commutator of two operators.
\end_layout

\begin_layout Plain Layout

    """
\end_layout

\begin_layout Plain Layout

    return A @ B - B @ A
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

def quantum_liouville(rho,
 t,
 H_constant):
\end_layout

\begin_layout Plain Layout

    """
\end_layout

\begin_layout Plain Layout

       Implement the quantum Liouville equation for
\end_layout

\begin_layout Plain Layout

       a constant Hamiltonian
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

       For use with the odeintw.odeintw() function
\end_layout

\begin_layout Plain Layout

    """
\end_layout

\begin_layout Plain Layout

    drhodt = -(1j/hbar)*commutator(H_constant,
 rho)
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    return drhodt
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Parameters
\end_layout

\begin_layout Plain Layout

nt = 75 # [] number of time steps
\end_layout

\begin_layout Plain Layout

gamma = 0.025 # [eV] tunneling energy
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Calculations
\end_layout

\begin_layout Plain Layout

T = np.pi*hbar/gamma # time scale
\end_layout

\begin_layout Plain Layout

t = np.linspace(0,
 4*T,
 nt)
\end_layout

\begin_layout Plain Layout

H = -gamma*Sx # [eV] Hamiltonian
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

psi0 = ket0 # initial state - state vector
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

rho0 = psi0 @ dag( psi0 )
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Integrate the solution for the quantum Liouville equation
\end_layout

\begin_layout Plain Layout

sol = odeintw(quantum_liouville,
 rho0,
 t,
 args=(H,) )
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

Pt_ode = np.zeros([nt,])
\end_layout

\begin_layout Plain Layout

Pt_exp = np.zeros([nt,])
\end_layout

\begin_layout Plain Layout

Et_ode = np.zeros((nt,))
\end_layout

\begin_layout Plain Layout

Et_exp = np.zeros((nt,))
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Extract data from ode solution;
 also calculate Schrodinger version
\end_layout

\begin_layout Plain Layout

for it in range(nt):
\end_layout

\begin_layout Plain Layout

    # Density matrix - extract data
\end_layout

\begin_layout Plain Layout

    Pt_ode[it] = expectation_value(-Sz,
 sol[it])
\end_layout

\begin_layout Plain Layout

    Et_ode[it] = expectation_value(H,
 sol[it])
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    # State vector - calculate evolution,
 extract data
\end_layout

\begin_layout Plain Layout

    Ut = sp.linalg.expm(-1j*t[it]*H/hbar)
\end_layout

\begin_layout Plain Layout

    psit = Ut @ psi0
\end_layout

\begin_layout Plain Layout

    Pt_exp[it] = expectation_value(-Sz,
 psit)
\end_layout

\begin_layout Plain Layout

    Et_exp[it] = expectation_value(H,
 psit)
\end_layout

\begin_layout Plain Layout

        
\end_layout

\begin_layout Plain Layout

\end_layout

