\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

from scipy.linalg import expm
\end_layout

\begin_layout Plain Layout

import numpy as np
\end_layout

\begin_layout Plain Layout

import matplotlib.pyplot as plt
\end_layout

\begin_layout Plain Layout

import os
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

def dag( Q ):
\end_layout

\begin_layout Plain Layout

    '''Calculates the Hermitian adjoint of a quantum object
\end_layout

\begin_layout Plain Layout

       (vector or operator).
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    Args:
\end_layout

\begin_layout Plain Layout

      qobj:
 an numpy.ndarray representing a operator,
 bra,
\end_layout

\begin_layout Plain Layout

            or ket.
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    Returns:
\end_layout

\begin_layout Plain Layout

      The Hermitian adjoint of Q.
\end_layout

\begin_layout Plain Layout

    
\end_layout

\begin_layout Plain Layout

    '''
\end_layout

\begin_layout Plain Layout

    
\end_layout

\begin_layout Plain Layout

    return np.conj( Q.transpose() )
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Constants
\end_layout

\begin_layout Plain Layout

ket0 = np.array([[1],[0]],
 dtype='complex');
\end_layout

\begin_layout Plain Layout

ket1 = np.array([[0],[1]],
 dtype='complex');
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

I = np.array([[1,
 0],
 [0,
 1]],
 dtype='complex');
\end_layout

\begin_layout Plain Layout

X = np.array([[0,
 1],
 [1,
 0]],
 dtype='complex');
\end_layout

\begin_layout Plain Layout

Z = np.array([[1,
 0],
 [0,
 -1]],
 dtype='complex');
\end_layout

\begin_layout Plain Layout

hbar = 6.582E-16 # [eV*s] Planck's constant (reduced)
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Parameters
\end_layout

\begin_layout Plain Layout

gamma = 0.05 # [eV] tunneling energy
\end_layout

\begin_layout Plain Layout

Ek = 0.421 # [eV] kink energy
\end_layout

\begin_layout Plain Layout

T = np.pi*hbar/gamma # [s] time scale
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Initial state - product of states 1 and 0
\end_layout

\begin_layout Plain Layout

psi0 = np.kron( ket0,
 ket1 )
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

nt = 125 # number of time points
\end_layout

\begin_layout Plain Layout

t = np.linspace(0,
 8*T,
 nt) # time vector
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Calculations
\end_layout

\begin_layout Plain Layout

H0 = -gamma*X # [eV] Hamiltonian for cell 0
\end_layout

\begin_layout Plain Layout

H1 = -gamma*X # [eV] Hamiltonian for cell 1
\end_layout

\begin_layout Plain Layout

Hint = - 0.5*Ek * np.kron(Z,
 Z) # [eV] interaction term
\end_layout

\begin_layout Plain Layout

# [eV] total Hamiltonian
\end_layout

\begin_layout Plain Layout

H = np.kron(I,
 H0) + np.kron(H1,
 I) + Hint
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# polarization operator for cell 0
\end_layout

\begin_layout Plain Layout

Z0 = np.kron(I,
 Z)
\end_layout

\begin_layout Plain Layout

# polarization operator for cell 1
\end_layout

\begin_layout Plain Layout

Z1 = np.kron(Z,
 I)
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Storage vector
\end_layout

\begin_layout Plain Layout

Pt = np.zeros((2,nt)) # polarization in time
\end_layout

\begin_layout Plain Layout

Et = np.zeros((nt,)) # [eV] energy in time
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

for tidx,
 tval in enumerate(t):
\end_layout

\begin_layout Plain Layout

    # Time-dependent state
\end_layout

\begin_layout Plain Layout

    psit = expm( - 1j*tval*H/hbar ) @ psi0
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

	# calculate polarizations
\end_layout

\begin_layout Plain Layout

    Pt[0,tidx] = -np.real( dag(psit) @ Z0 @ psit )[0,0]
\end_layout

\begin_layout Plain Layout

    Pt[1,tidx] = -np.real( dag(psit) @ Z1 @ psit )[0,0]
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    # calculate energy expectation value
\end_layout

\begin_layout Plain Layout

    Et[tidx] = np.real( dag(psit) @ H @ psit )[0,0]
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

fig,
 ax = plt.subplots(2,1)
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

ax[0].plot(t/T,
 Pt[0,:],
 marker='o',
 label='Cell 0');
\end_layout

\begin_layout Plain Layout

ax[0].plot(t/T,
 Pt[1,:],
 marker='v',
 label='Cell 1');
\end_layout

\begin_layout Plain Layout

ax[0].grid(True)
\end_layout

\begin_layout Plain Layout

ax[0].set_ylabel(r'$P$',
 fontsize=18)
\end_layout

\begin_layout Plain Layout

ax[0].set_xlim(t[0]/T,
 t[-1]/T)
\end_layout

\begin_layout Plain Layout

plt.tight_layout()
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

ax[1].plot(t/T,
 Et/Ek,
 marker='o');
\end_layout

\begin_layout Plain Layout

ax[1].grid(True)
\end_layout

\begin_layout Plain Layout

ax[1].set_ylabel(r'$E/E_k$',
 fontsize=18)
\end_layout

\begin_layout Plain Layout

ax[1].set_xlabel(r'$t/T$',
 fontsize=18)
\end_layout

\begin_layout Plain Layout

ax[1].set_xlim(t[0]/T,
 t[-1]/T)
\end_layout

\begin_layout Plain Layout

ax[1].set_ylim(-.25,
 0.75)
\end_layout

\begin_layout Plain Layout

plt.tight_layout()
\end_layout

