\begin_layout Plain Layout

# Constants
\end_layout

\begin_layout Plain Layout

hbar = 6.58E-16 # [eV*s] the reduced Planck constant
\end_layout

\begin_layout Plain Layout

ket0 = np.array([[1],[0]],
 dtype='complex')
\end_layout

\begin_layout Plain Layout

Sx = np.array([[0,
 1],[1,
 0]],
 dtype='complex')
\end_layout

\begin_layout Plain Layout

Sz = np.array([[1,
