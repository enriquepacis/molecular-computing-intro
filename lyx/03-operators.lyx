Exercise 3.3
\end_layout

\begin_layout Plain Layout
Find the following matrix elements of the 
\begin_inset Formula $\mathbf{X}$
\end_inset

 operator.
\begin_inset CommandInset label
LatexCommand label
name "exer:MatrixElementsOfNOT"

\end_inset

.
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\Braket{0|\mathbf{X}|0}$
\end_inset


\begin_inset Newline newline
\end_inset

#+html:
 <details><summary>Show/hide solution...</summary>
\begin_inset Formula 
\begin{align*}
\braket{0|\mathbf{X}|0} & =\bra{0}\left(\mathbf{X}\ket{0}\right)=\bra{0}\left(\ket{1}\right)\\
 & =\braket{0|1}=0
\end{align*}

\end_inset

#+html:
 </details>
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\Braket{0|\mathbf{X}|1}$
\end_inset


\begin_inset Newline newline
\end_inset

#+html:
 <details><summary>Show/hide solution...</summary>
\begin_inset Formula 
\begin{align*}
\braket{0|\mathbf{X}|1} & =\bra{0}\left(\mathbf{X}\ket{1}\right)=\bra{0}\left(\ket{0}\right)\\
 & =\braket{0|0}=1
\end{align*}

\end_inset

#+html:
 </details>
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\Braket{1|\mathbf{X}|0}$
\end_inset


\begin_inset Newline newline
\end_inset

#+html:
 <details><summary>Show/hide solution...</summary>
\begin_inset Formula 
\begin{align*}
\braket{1|\mathbf{X}|0} & =\bra{1}\left(\mathbf{X}\ket{0}\right)=\bra{1}\left(\ket{1}\right)\\
 & =\braket{1|1}=1
\end{align*}

\end_inset

#+html:
 </details>
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\Braket{1|\mathbf{X}|1}$
\end_inset


\begin_inset Newline newline
\end_inset

#+html:
 <details><summary>Show/hide solution...</summary>
\begin_inset Formula 
\begin{align*}
\braket{1|\mathbf{X}|1} & =\bra{1}\left(\mathbf{X}\ket{1}\right)=\bra{1}\left(\ket{0}\right)\\
 & =\braket{1|0}=0
\end{align*}

\end_inset

#+html:
 </details>
\end_layout

\begin_layout Plain Layout
#+end_note
\end_layout

\end_inset


\end_layout

