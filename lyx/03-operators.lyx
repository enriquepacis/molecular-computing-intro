\begin_layout Plain Layout

\series bold
Exercise 3.4
\end_layout

\begin_layout Plain Layout
Calculate the inner products 
\begin_inset Formula $\vec{e}_{2}^{T}M\vec{e}_{3}$
\end_inset

 and 
\begin_inset Formula $\vec{e}_{3}^{T}M\vec{e}_{2}$
\end_inset

.
\end_layout

\begin_layout Plain Layout
#+html:
 <details><summary>Show/hide solution..</summary>
\begin_inset Formula 
\[
\vec{e}_{2}^{T}M\vec{e}_{3}=\left[\begin{array}{ccc}
0 & 1 & 0\end{array}\right]\left[\begin{array}{ccc}
a & b & c\\
d & e & f\\
g & h & i
\end{array}\right]\left[\begin{array}{c}
0\\
0\\
1
\end{array}\right]=\left[\begin{array}{ccc}
0 & 1 & 0\end{array}\right]\left[\begin{array}{c}
c\\
f\\
i
\end{array}\right]=f=M_{2,3}
\]

\end_inset


\begin_inset Formula 
\[
\vec{e}_{3}^{T}M\vec{e}_{2}=\left[\begin{array}{ccc}
0 & 0 & 1\end{array}\right]\left[\begin{array}{ccc}
a & b & c\\
d & e & f\\
g & h & i
\end{array}\right]\left[\begin{array}{c}
0\\
1\\
0
\end{array}\right]=\left[\begin{array}{ccc}
0 & 0 & 1\end{array}\right]\left[\begin{array}{c}
b\\
e\\
h
\end{array}\right]=h=M_{3,2}
\]

\end_inset


\end_layout

\begin_layout Plain Layout
We can see that 
\begin_inset Formula $\vec{e}_{2}^{T}M\vec{e}_{3}$
\end_inset

 and 
\begin_inset Formula $\vec{e}_{3}^{T}M\vec{e}_{2}$
\end_inset

 are 
\begin_inset Formula $M_{2,3}$
\end_inset

 and 
\begin_inset Formula $M_{3,2}$
\end_inset

,
 respectively,
 the 
\begin_inset Formula $\left(2,3\right)$
\end_inset

 and 
\begin_inset Formula $\left(3,2\right)$
\end_inset

 
\series bold
matrix elements
\series default
 of 
\begin_inset Formula $M$
\end_inset

.
 This is in direct analogy to 
\begin_inset Formula $\braket{\chi|\mathbf{M}|\psi}$
\end_inset

 being the 
\begin_inset Formula $\left(\chi,\psi\right)$
\end_inset

 matrix element of 
\begin_inset Formula $\mathbf{M}$
\end_inset

.
\end_layout

