\begin_layout Subsection
von Neumann Entropy
\end_layout

\begin_layout Itemize
The von Neumann entropy of system 
\begin_inset Formula $X$
\end_inset

,
 
\begin_inset Formula $S_{VN}$
\end_inset

,
 is the information about 
\begin_inset Formula $X$
\end_inset

 missing locally from 
\begin_inset Formula $X$
\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
If 
\begin_inset Formula $S_{X}=0$
\end_inset

,
 then 
\begin_inset Formula $\hat{\rho}_{X}$
\end_inset

 is pure (not entangled with any other system)
\end_layout

\begin_layout Itemize
If 
\begin_inset Formula $S_{X}>0$
\end_inset

,
 then 
\begin_inset Formula $X$
\end_inset

 is entangled with another system
\end_layout

\end_deeper
\begin_layout Itemize
The von Neumann entropy of a system with density matrix 
\begin_inset Formula $\rho$
\end_inset

 is
\begin_inset Formula 
\[
S_{VN}=-\text{Tr}\;\left(\rho\;\text{\ensuremath{\ln}\ensuremath{\rho}}\right),
\]

\end_inset

where 
\begin_inset Formula $\ln\rho$
\end_inset

 denotes the matrix natural logarithm of 
\begin_inset Formula $\rho$
\end_inset

,
 and 
\begin_inset Formula $\text{Tr}$
\end_inset

 denotes the trace
\end_layout

\begin_layout Itemize
If the density matrix is written in a basis of measurement eigenvectors 
\begin_inset Formula $\left\{ \ket{i}\right\} $
\end_inset

 ,
 
\begin_inset Formula $\rho=\sum_{ij}\rho_{ij}\ket{i}\bra{j}$
\end_inset

,
 then the von Neumann entropy may be calculated from the diagonal elements,
 
\begin_inset Formula $\rho_{ii},$
\end_inset

which are probabilities:
\begin_inset Formula 
\[
S_{VN}=-\sum_{i}\rho_{ii}\ln\rho_{ii}
\]

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
We can see that the von Neumann entropy is nothing more than the Shannon entropy applied to the diagonal of the density matrix
\end_layout

\end_deeper
