\begin_layout Subsection
Quantum Mutual Information
\end_layout

\begin_layout Itemize
Another measure of entanglement is quantum mutual information
\end_layout

\begin_layout Itemize
Consider a system 
\begin_inset Formula $AB$
\end_inset

 with reduced density matrices 
\begin_inset Formula $\hat{\rho}_{A}$
\end_inset

 and 
\begin_inset Formula $\hat{\rho}_{B}$
\end_inset

.
\end_layout

\begin_layout Itemize
The quantum mutual information,
 
\begin_inset Formula $I$
\end_inset

,
 of 
\begin_inset Formula $AB$
\end_inset

 is
\begin_inset Formula 
\[
I=S_{A}+S_{B}-S_{AB}
\]

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
This is the total information missing locally from 
\begin_inset Formula $A$
\end_inset

 and 
\begin_inset Formula $B$
\end_inset

,
 but not missing from the composite 
\begin_inset Formula $AB$
\end_inset

.
\end_layout

\begin_layout Itemize
We can think of this as the information content of the entanglement between 
\begin_inset Formula $A$
\end_inset

 and 
\begin_inset Formula $B$
\end_inset


\end_layout

\end_deeper
