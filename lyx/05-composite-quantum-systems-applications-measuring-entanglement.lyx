\begin_layout Plain Layout

def bipartite_traceout( rho,
 dX,
 dY,
 verbose=False ):
\end_layout

\begin_layout Plain Layout

    """
\end_layout

\begin_layout Plain Layout

       BipartiteTraceout returns the reduced density matrix of the two
\end_layout

\begin_layout Plain Layout

       components in a bipartite system XY
\end_layout

\begin_layout Plain Layout

       
\end_layout

\begin_layout Plain Layout

       rho_r_X,
 rho_r_Y = BipartiteTraceout( rho,
 dX,
 dY )
\end_layout

\begin_layout Plain Layout

       
\end_layout

\begin_layout Plain Layout

       INPUTS
\end_layout

\begin_layout Plain Layout

       ======
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

       rho      Density matrix for the global system XY.
\end_layout

\begin_layout Plain Layout

       
\end_layout

\begin_layout Plain Layout

       dX       The dimension of subsystem X.
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

       dY       The dimension of subsystem Y.
\end_layout

\begin_layout Plain Layout

       
\end_layout

\begin_layout Plain Layout

       Assume that the global system is initially in a product state
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

           rho(0) = kron( rhoX(0),
 rhoY(0) ) ,
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

       and that it undergoes unitary evolution under the quantum
\end_layout

\begin_layout Plain Layout

       Liouville equation:
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

           rho(t) = U(H,t) * ( rho(0) ) * (U(H,t)') ,
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

       where U(H,
 t) = expm( - ( 1i/hbar ) * H * t).
\end_layout

\begin_layout Plain Layout

    """
\end_layout

\begin_layout Plain Layout

    rho_r_X = np.zeros([dX,
 dX],
 dtype='complex')
\end_layout

\begin_layout Plain Layout

    rho_r_Y = np.zeros([dY,
 dY],
 dtype='complex')
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    # Trace rho over the degrees of freedom of Y to get rho_r_X
\end_layout

\begin_layout Plain Layout

    for k in range(dY):
\end_layout

\begin_layout Plain Layout

        """
\end_layout

\begin_layout Plain Layout

        MATLAB source:
\end_layout

\begin_layout Plain Layout

        Xaddend = rho[k:dY:k+(dX-1)*dY,
 k:dY:k+(dX-1)*dY]
\end_layout

\begin_layout Plain Layout

        """
\end_layout

\begin_layout Plain Layout

        """
\end_layout

\begin_layout Plain Layout

           Slicing ranges are:
 start:end:[step]
\end_layout

\begin_layout Plain Layout

           By default,
 step=1
\end_layout

\begin_layout Plain Layout

        """
\end_layout

\begin_layout Plain Layout

        rho_r_X += rho[k:k+(dX-1)*dY+1:dY,
 k:k+(dX-1)*dY+1:dY]
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    # Trace rho over the degrees of freedom of X to get rho_r_Y
\end_layout

\begin_layout Plain Layout

    for k in range(dX):
\end_layout

\begin_layout Plain Layout

        """
\end_layout

\begin_layout Plain Layout

        MATLAB source:
\end_layout

\begin_layout Plain Layout

        Yaddend = rho[dY*k-(dY-1):dY*k,
 dY*k-(dY-1):dY*k ]
\end_layout

\begin_layout Plain Layout

        """
\end_layout

\begin_layout Plain Layout

        rho_r_Y += rho[dY*k:dY*(k+1),
 dY*k:dY*(k+1)]
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    return (rho_r_X,
 rho_r_Y)
\end_layout

