\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Calculations
\end_layout

\begin_layout Plain Layout

f = f_invcm * c_cms # [Hz] oscillator frequency
\end_layout

\begin_layout Plain Layout

