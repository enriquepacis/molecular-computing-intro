\begin_layout Itemize
We've considered some operators now,
 from different contexts
\end_layout

\begin_deeper
\begin_layout Itemize
the Hamiltonian,
 
\begin_inset Formula $\mathcal{H}$
\end_inset

,
 describes the physics of the system
\end_layout

\begin_layout Itemize
other operators,
 such as 
\begin_inset Formula $\mathbf{X}$
\end_inset

,
 
\begin_inset Formula $\mathbf{Y}$
\end_inset

,
 
\begin_inset Formula $\mathbf{Z}$
\end_inset

,
 and 
\begin_inset Formula $\mathbf{H}$
\end_inset

 transform a qubit and may be thought of as gates for process quantum information
\end_layout

\end_deeper
\begin_layout Itemize
We now focus on quantum information and a way to visualize transformations of a qubit
\end_layout

\begin_layout Itemize
To do this,
 we introduce the density operator and the Bloch vector
\end_layout

\begin_layout Subsubsection
The Density Operator
\end_layout

\begin_layout Itemize
For a given state
\begin_inset Formula 
\[
\ket{\psi}\leftrightarrow\begin{bmatrix}c_{0}\\
c_{1}
\end{bmatrix},
\]

\end_inset

we can form the operator
\begin_inset Formula 
\begin{equation}
\hat{\rho}=\ket{\psi}\bra{\psi}=\begin{bmatrix}c_{0}\\
c_{1}
\end{bmatrix}\left[\begin{array}{cc}
c_{0}^{\ast} & c_{1}^{\ast}\end{array}\right]=\begin{bmatrix}c_{0}c_{0}^{\ast} & c_{0}c_{1}^{\ast}\\
c_{1}c_{0}^{\ast} & c_{1}c_{1}^{\ast}
\end{bmatrix}\label{eq:DensityOperatorSingleQubit}
\end{equation}

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
\begin_inset Formula $\hat{\rho}$
\end_inset

 is called a density operator or a density matrix
\end_layout

\end_deeper
\begin_layout Itemize
Expectation values may be calculated from density matrices
\end_layout

\begin_deeper
\begin_layout Itemize
For an operator 
\begin_inset Formula $\mathbf{O}$
\end_inset

,
 the expectation value 
\begin_inset Formula $\Braket{\mathbf{O}}$
\end_inset

 is given by
\begin_inset Note Note
status open

\begin_layout Plain Layout
\begin_inset Formula $\Braket{\mathbf{O}}=\text{Tr}\;\left(\mathbf{O}\hat{\rho}\right)=\text{Tr}\;\left(\hat{\rho}\mathbf{O}\right)\stackrel{\left(\ref{eq:trace}\right)}{=}\sum_{j}\Braket{j|\mathbf{O}\hat{\rho}|j}=\sum_{j}\Braket{j|\hat{\rho}\mathbf{O}|j}$
\end_inset


\end_layout

\end_inset


\begin_inset Formula 
\begin{equation}
\Braket{\mathbf{O}}=\text{Tr}\;\left(\mathbf{O}\hat{\rho}\right)=\text{Tr}\;\left(\hat{\rho}\mathbf{O}\right)=\sum_{j}\Braket{j|\mathbf{O}\hat{\rho}|j}=\sum_{j}\Braket{j|\hat{\rho}\mathbf{O}|j}\label{eq:ExpectationValueDensityMatrix}
\end{equation}

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
This expression is completely equivalent to the expectation value of Equation 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:ExpectationValueStateVector"
nolink "false"

\end_inset


\end_layout

\begin_layout Itemize
A property that sometimes comes in useful for the trace is that we can cyclically permute the operators in a trace and still get the same value:
\begin_inset Formula 
\begin{equation}
\text{Tr}\;\left(\mathbf{A}\mathbf{B}\mathbf{C}\right)=\text{Tr}\;\left(\mathbf{C}\mathbf{A}\mathbf{B}\right)=\text{Tr}\;\left(\mathbf{B}\mathbf{C}\mathbf{A}\right)\label{eq:TraceCyclicPermutability}
\end{equation}

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
We can do this as long as we move a single operator at a time from one end of the product to the other
\end_layout

\end_deeper
\begin_layout Itemize
For a product of two operators,
 Equation 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:TraceCyclicPermutability"
nolink "false"

\end_inset

 reduces to
\begin_inset Formula 
\begin{equation}
\text{Tr}\;\left(\mathbf{A}\mathbf{B}\right)=\text{Tr}\;\left(\mathbf{B}\mathbf{A}\right)\label{eq:TraceCyclicPermutabilityAB}
\end{equation}

\end_inset


\end_layout

\end_deeper
\end_deeper
