\begin_layout Plain Layout

# select the initial state
\end_layout

\begin_layout Plain Layout

start = 'coherent'
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

N = 15
\end_layout

\begin_layout Plain Layout

nt = 75
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Create a QHO object
\end_layout

\begin_layout Plain Layout

# Uses default m = 6 amu and f = 300 inv cm
\end_layout

\begin_layout Plain Layout

# This also creates all the operators:
\end_layout

\begin_layout Plain Layout

#   Hamiltonian,
 raising and lowering,
\end_layout

\begin_layout Plain Layout

#   position,
 momentum
\end_layout

\begin_layout Plain Layout

# It also calculates the characteristic
\end_layout

\begin_layout Plain Layout

#   length and energy
\end_layout

\begin_layout Plain Layout

qosc = QHO(N=N)
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

X0 = qosc.Q0 # [nm] characteristic length
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

T = qosc.T # oscillation period
\end_layout

\begin_layout Plain Layout

t = np.linspace(0,
 3*T,
 nt).flatten()
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Storage arrays
\end_layout

\begin_layout Plain Layout

PDE = np.zeros([N,
 nt]) # prob dist over energy
\end_layout

\begin_layout Plain Layout

PDX = np.zeros([N,
 nt]) # prob dist over position
\end_layout

\begin_layout Plain Layout

Et = np.zeros((nt,))
\end_layout

\begin_layout Plain Layout

Xt = np.zeros((nt,))
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Prepare the initial state
\end_layout

\begin_layout Plain Layout

if start == 'eigenstate':
\end_layout

\begin_layout Plain Layout

    psi0 = qosc.energy_state(0)
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

elif start == 'coherent':
\end_layout

\begin_layout Plain Layout

    d = 1 + 1j # displacement
\end_layout

\begin_layout Plain Layout

    D = qosc.displacement_operator(d)
\end_layout

\begin_layout Plain Layout

    # Recall that D|0> "selects" the first column of D
\end_layout

\begin_layout Plain Layout

    psi0 = D @ qosc.energy_state(0)
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

elif start == 'arbitrary':
\end_layout

\begin_layout Plain Layout

    psi0 = la.normalize( qosc.energy_state(1) + qosc.energy_state(2) )
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Exponential time evolution (state-vector formalism)
\end_layout

\begin_layout Plain Layout

for it,
 tt in enumerate(t):
\end_layout

\begin_layout Plain Layout

    Ut = sp.linalg.expm(-1j * qosc.H * tt / const.hbar )
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    psit = Ut @ psi0
\end_layout

\begin_layout Plain Layout

    psitX = qosc.change_basis(psit,
 fr='energy',
 to='position')
\end_layout

\begin_layout Plain Layout

    
\end_layout

\begin_layout Plain Layout

    PDE[:,it] = la.state_to_probability(psit).real
\end_layout

\begin_layout Plain Layout

    PDX[:,it] = la.state_to_probability(psitX).real
\end_layout

\begin_layout Plain Layout

    Et[it] = la.expectation_value( qosc.H,
 psit,
 validate=False )
\end_layout

\begin_layout Plain Layout

    Xt[it] = la.expectation_value( qosc.X,
 psit,
 validate=False )
\end_layout

\begin_layout Plain Layout

\end_layout

