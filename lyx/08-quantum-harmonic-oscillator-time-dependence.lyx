# Quantum Liouville evolution    
\end_layout

\begin_layout Plain Layout

from odeintw import odeintw
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

rho0 = la.density_matrix(psi0) # form a density operator
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# Integrate the solution
\end_layout

\begin_layout Plain Layout

sol = odeintw(quantum_liouville,
 rho0,
 t,
 args=(qosc.H,) )
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

PDE_ode = np.zeros([N,
 nt])
\end_layout

\begin_layout Plain Layout

PDX_ode = np.zeros([N,
 nt])
\end_layout

\begin_layout Plain Layout

Et_ode = np.zeros((nt,))
\end_layout

\begin_layout Plain Layout

