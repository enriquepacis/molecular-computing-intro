\begin_layout Plain Layout
Find the probability distribution of a system prepared in the initial state
\begin_inset Formula 
\[
\psi\left(x,0\right)=\sum_{n=0}^{N}c_{n}\psi_{n}\left(x\right).
\]

\end_inset


\end_layout

\begin_layout Plain Layout
#+html:
 <details><summary>Show/hide solution ...</summary>
\end_layout

\begin_layout Plain Layout
Apply the time evolution operator:
\begin_inset Formula 
\begin{align*}
\psi\left(x,t\right) & =e^{-it\hat{H}/\hbar}\psi\left(x,0\right)=e^{-it\hat{H}/\hbar}\sum_{n=0}^{N}c_{n}\psi_{n}\left(x\right)\\
 & =\sum_{n=0}^{N}c_{n}e^{-it\hat{H}/\hbar}\psi_{n}\left(x\right)\\
 & \stackrel{\left(\ref{eq:EigenstateEvolution}\right)}{=}\sum_{n=0}^{N}c_{n}e^{-itE_{n}/\hbar}\psi_{n}\left(x\right)
\end{align*}

\end_inset


\end_layout

