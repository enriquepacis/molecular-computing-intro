\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

for it in range(nt):
\end_layout

\begin_layout Plain Layout

    PDE_ode[:,it] = np.diag(sol[it]).real
\end_layout

\begin_layout Plain Layout

    rhoX = qosc.change_basis(sol[it],
