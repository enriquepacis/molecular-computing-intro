\begin_layout Section
Time Dependence of the QHO
\end_layout

\begin_layout Itemize
So far,
 we looked only at the eigenstates of 
\begin_inset Formula $\hat{H}$
\end_inset

 for the QHO
\end_layout

\begin_layout Itemize
Let us now consider the time dependence of the QHO
\end_layout

\begin_layout Subsection
Time Dependence of an Eigenstate of 
\begin_inset Formula $\hat{H}$
\end_inset


\end_layout

\begin_layout Itemize
Consider the time dependence of 
\begin_inset Formula $\ket{\psi}$
\end_inset

,
 prepared in an eigenstate state:
 
\begin_inset Formula $\ket{\psi(0}=\ket{\psi_{n}}$
\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
The time dependence is 
\begin_inset Formula 
\begin{align*}
\ket{\psi\left(t\right)} & =e^{-i\hat{H}t/\hbar}\ket{\psi_{n}}\\
 & =\left(\sum_{k=0}^{\infty}\frac{1}{k!}\left(-\frac{it}{\hbar}\right)^{k}\hat{H}^{k}\right)\ket{\psi_{n}}=\sum_{k=0}^{\infty}\frac{1}{k!}\left(-\frac{it}{\hbar}\right)^{k}\hat{H}^{k}\ket{\psi_{n}}
\end{align*}

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
Notice that
\begin_inset Formula 
\begin{align*}
\hat{H}^{k}\ket{\psi_{n}} & =\hat{H}^{k-1}\hat{H}\ket{\psi_{n}}\stackrel{\left(\ref{eq:qho-tise-braket}\right)}{=}\hat{H}^{k-1}E_{n}\ket{\psi_{n}}=E_{n}\hat{H}^{k-1}\ket{\psi_{n}}\\
 & =E_{n}\hat{H}^{k-2}\hat{H}\ket{\psi_{n}}=E_{n}^{2}\hat{H}^{k-2}\ket{\psi_{n}}\cdots\\
 & =E_{n}^{k}\ket{\psi_{n}}
\end{align*}

\end_inset


\end_layout

\begin_layout Itemize
Thus,
 our time evolution becomes
\begin_inset Formula 
\begin{align}
\ket{\psi\left(t\right)} & =\sum_{k=0}^{\infty}\frac{1}{k!}\left(-\frac{it}{\hbar}\right)^{k}E_{n}^{k}\ket{\psi_{n}}=\left(\sum_{k=0}^{\infty}\frac{1}{k!}\left(-\frac{it}{\hbar}\right)^{k}E_{n}^{k}\right)\ket{\psi_{n}}\nonumber \\
 & =e^{-itE_{n}/\hbar}\ket{\psi_{n}}\label{eq:EigenstateEvolution}
\end{align}

\end_inset


\end_layout

\begin_layout Itemize
We have turned a matrix exponential into a scalar exponential,
 because the time evolution operator acts on 
\begin_inset Formula $\ket{\psi_{n}}$
\end_inset


\end_layout

\end_deeper
\end_deeper
\begin_layout Itemize
We can show that the probability distribution for an eigenstate of 
\begin_inset Formula $\hat{H}$
\end_inset

 is constant.
 It is easier to do this in the functional form of 
\begin_inset Formula $\psi_{n}\left(x,t\right)$
\end_inset


\begin_inset Formula 
\[
\left|\psi_{n}\left(x,t\right)\right|^{2}=\psi_{n}^{\ast}\left(x,t\right)\psi_{n}\left(x,t\right)=e^{it\hat{H}/\hbar}\psi_{n}^{\ast}\left(x\right)e^{-it\hat{H}/\hbar}\psi_{n}\left(x\right)=\psi_{n}^{\ast}\left(x\right)\psi_{n}\left(x\right)=\left|\psi_{n}\left(x\right)\right|^{2}
\]

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
Thus,
 the time evolution of the probability distribution 
\begin_inset Formula $\left|\psi_{n}\left(x,t\right)\right|^{2}$
\end_inset

 for an eigenstate of 
\begin_inset Formula $\hat{H}$
\end_inset

 is time independent
\end_layout

\end_deeper
\begin_layout Subsection
Time Dependence of non-eigenstates of 
\begin_inset Formula $\hat{H}$
\end_inset


\end_layout

\begin_layout Itemize
We can form noneigenstates of 
\begin_inset Formula $\hat{H}$
\end_inset

 by making superpositions of eigenstates.
\end_layout

