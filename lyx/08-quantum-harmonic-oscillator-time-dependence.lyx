\begin_layout Plain Layout

\series bold
Exercise 8.5
\end_layout

\begin_layout Plain Layout
Plot the time-dependent probability distributions over position and energy for a quantum harmonic oscillator for three different initial states:
\begin_inset Formula 
\begin{equation}
\psi_{a}\left(x,0\right)=\psi_{2}\left(x\right)\label{eq:psi0_stationary}
\end{equation}

\end_inset


\begin_inset Formula 
\begin{equation}
\psi_{b}\left(x,0\right)=\frac{1}{\sqrt{2}}\left(\psi_{1}\left(x\right)+\psi_{2}\left(x\right)\right),\;\text{and}\label{eq:psi0_arbitrary}
\end{equation}

\end_inset


\begin_inset Formula 
\begin{equation}
\psi_{c}\left(x,0\right)=D\left(\alpha\right)\psi_{0}\left(x\right),\label{eq:psi0_glauber}
\end{equation}

\end_inset

where 
\begin_inset Formula $D\left(\alpha\right)$
\end_inset

 is the displacement operator,
\begin_inset Formula 
\[
D\left(\alpha\right)=e^{\alpha\hat{a}^{\dagger}-\alpha\hat{a}}
\]

\end_inset

for a complex parameter 
\begin_inset Formula $\alpha$
\end_inset

.
 You should see that the state 
\begin_inset Formula $\psi_{c}\left(x,0\right)$
\end_inset

 is a coherent state or 
\begin_inset Quotes eld
\end_inset

Glauber state,
\begin_inset Quotes erd
\end_inset

 and it behaves like a classical oscillator.
\end_layout

