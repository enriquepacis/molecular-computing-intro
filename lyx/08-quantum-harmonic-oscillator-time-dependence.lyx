\begin_layout Plain Layout

\series bold
Exercise 8.3
\end_layout

\begin_layout Plain Layout
Find the probability distribution of
\begin_inset Formula 
\[
\psi\left(x,t\right)=\psi_{m}\left(x\right)e^{-iE_{m}t/\hbar}+\psi_{n}\left(x\right)e^{-iE_{n}t/\hbar}.
\]

\end_inset


\end_layout

\begin_layout Plain Layout
#+html:
 <details><summary>Show/hide solution ...</summary>
\end_layout

\begin_layout Plain Layout
Here,
 we follow the pattern from before:
\begin_inset Formula 
\begin{align*}
\left|\psi\left(x,t\right)\right|^{2} & =\left|\psi_{m}\left(x\right)e^{-iE_{m}t/\hbar}+\psi_{n}\left(x\right)e^{-iE_{n}t/\hbar}\right|^{2}\\
 & =\left(\psi_{m}\left(x\right)e^{-iE_{m}t/\hbar}+\psi_{n}\left(x\right)e^{-iE_{n}t/\hbar}\right)^{\ast}\left(\psi_{m}\left(x\right)e^{-iE_{m}t/\hbar}+\psi_{n}\left(x\right)e^{-iE_{n}t/\hbar}\right)\\
 & =\left(\psi_{m}^{\ast}\left(x\right)e^{iE_{m}t/\hbar}+\psi_{n}^{\ast}\left(x\right)e^{iE_{n}t/\hbar}\right)\left(\psi_{m}\left(x\right)e^{-iE_{m}t/\hbar}+\psi_{n}\left(x\right)e^{-iE_{n}t/\hbar}\right)\\
 & =\psi_{m}^{\ast}\left(x\right)\psi_{m}\left(x\right)+\psi_{m}^{\ast}\left(x\right)\psi_{n}\left(x\right)e^{-i\left(E_{n}-E_{m}\right)t/\hbar}+\psi_{m}\left(x\right)\psi_{n}^{\ast}\left(x\right)e^{-i\left(E_{m}-E_{n}\right)t/\hbar}+\psi_{n}^{\ast}\left(x\right)\psi_{n}\left(x\right)\\
 & =\left|\psi_{m}\right|^{2}+\psi_{m}^{\ast}\left(x\right)\psi_{n}\left(x\right)e^{-i\left(E_{n}-E_{m}\right)t/\hbar}+\psi_{m}\left(x\right)\psi_{n}^{\ast}\left(x\right)e^{-i\left(E_{m}-E_{n}\right)t/\hbar}+\left|\psi_{n}\right|^{2}
\end{align*}

\end_inset

Notice that the superposition of two eigenstates now has a time-dependent probability distribution.
\end_layout

