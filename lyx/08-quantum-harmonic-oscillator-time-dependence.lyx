def state_to_probability( psi,
 verbose=False):
\end_layout

\begin_layout Plain Layout

    """
\end_layout

\begin_layout Plain Layout

       Convert a state vector to a probability
\end_layout

\begin_layout Plain Layout

       distribution.
\end_layout

\begin_layout Plain Layout

\end_layout

