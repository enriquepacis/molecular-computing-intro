 to='position')
\end_layout

\begin_layout Plain Layout

    PDX_ode[:,it] = np.diag(rhoX).real
\end_layout

\begin_layout Plain Layout

    Et_ode[it] = la.expectation_value( qosc.H,
 sol[it],
 validate=False )
\end_layout

\begin_layout Plain Layout

    Xt_ode[it] = la.expectation_value( qosc.X,
 sol[it],
 validate=False )
