\begin_layout Itemize
When a state has unit length (norm),
 it is said to be 
\series bold
normalized
\series default
,
 and it satisfies the following:
\begin_inset Formula 
\begin{equation}
\braket{\psi|\psi}=\sqrt{\braket{\psi|\psi}}=1\qquad(\text{normalization})\label{eq:DefineNormalization}
\end{equation}

\end_inset

Thus,
 we have seen above that the computational basis states 
\begin_inset Formula $\left\{ \ket{0},\ket{1}\right\} $
\end_inset

 are normalized
\end_layout

\begin_deeper
\begin_layout Itemize

\series bold
We need quantum states to be normalized (i.e.,
 they must satisfy Equation 
\series default

\begin_inset CommandInset ref
LatexCommand ref
reference "eq:DefineNormalization"

\end_inset


\series bold
) in order to have a probabilistic interpretation of their amplitudes
\end_layout

\end_deeper
\begin_layout Itemize
Any wave function 
\begin_inset Formula $\ket{\psi}$
\end_inset

 with 
\begin_inset Formula $0<\braket{\psi|\psi}<\infty$
\end_inset

 may be normalized to 
\begin_inset Formula $\braket{\psi^{\prime}|\psi^{\prime}}$
\end_inset

 such that 
\begin_inset Formula $\braket{\psi^{\prime}|\psi^{\prime}}=1$
\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
To do this,
 simply divide 
\begin_inset Formula $\ket{\psi}$
\end_inset

 by its length,
 
\begin_inset Formula $\sqrt{\braket{\psi^{\prime}|\psi^{\prime}}}$
\end_inset

:
\begin_inset Formula 
\begin{equation}
\ket{\psi^{\prime}}=\frac{\ket{\psi}}{\sqrt{\braket{\psi^{\prime}|\psi^{\prime}}}}\label{eq:NormalizePsi}
\end{equation}

\end_inset


\end_layout

\end_deeper
