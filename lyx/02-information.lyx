\begin_layout Plain Layout
Find 
\begin_inset Formula $\braket{0|0}$
\end_inset

 and 
\begin_inset Formula $\braket{1|1}$
\end_inset

.
\end_layout

\begin_layout Plain Layout
#+html:
 <details><summary>Show/hide solution...</summary>
\end_layout

\begin_layout Plain Layout
We can evaluate the inner products as follows:
\end_layout

\begin_layout Plain Layout
\begin_inset Formula 
\[
\braket{0|0}=\left[\begin{array}{cc}
1 & 0\end{array}\right]\left[\begin{array}{c}
1\\
0
\end{array}\right]=1\cdot1+0\cdot0=1
\]

\end_inset


\begin_inset Formula 
\[
\braket{1|1}=\left[\begin{array}{cc}
0 & 1\end{array}\right]\left[\begin{array}{c}
0\\
1
\end{array}\right]=0\cdot0+1\cdot1=1
\]

\end_inset

Thus,
 the computational basis states are normalized.
\begin_inset Newline newline
\end_inset

