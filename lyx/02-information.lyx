\begin_layout Itemize
When a pair of states 
\begin_inset Formula $\ket{\chi}$
\end_inset

 and 
\begin_inset Formula $\ket{\psi}$
\end_inset

 have zero inner product,
 they are said to be orthogonal,
 and they satisfy
\begin_inset Formula 
\begin{equation}
\braket{\psi|\chi}=\braket{\chi|\psi}=0\qquad(\text{orthogonality})\label{eq:Orthogonal}
\end{equation}

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
This is just like perpendicular (orthogonal) vectors in 2D or 3D when they have zero inner (dot) product
\end_layout

\end_deeper
