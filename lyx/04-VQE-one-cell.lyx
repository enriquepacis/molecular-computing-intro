\begin_body

\begin_layout Itemize
You've already experience the Schrödinger equation,
\begin_inset Formula 
\[
\hat{H}\ket{\psi_{n}}=E_{n}\ket{\psi_{n}}
\]

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
In QCA,
 we're often interested in the ground state,
 which is the lowest allowed energy of the quantum system
\end_layout

\begin_layout Itemize
Classically,
 we find the ground state by diagonalizing the Hamiltonian and finding its lowest eigenenergy,
 
\begin_inset Formula $E_{0}$
\end_inset

:
\begin_inset Formula 
\[
E_{0}=\Braket{\psi_{0}|\hat{H}|\psi_{0}}
\]

\end_inset


\end_layout

\begin_layout Itemize
This corresponds to the global minimum energy
\end_layout

\begin_layout Itemize
We call 
\begin_inset Formula $\ket{\psi_{0}}$
\end_inset

 the 
\series bold
ground state
\series default
,
 since it has the 
\series bold
lowest allowed energy
\series default
,
 
\begin_inset Formula $E_{0}$
\end_inset


\end_layout

\end_deeper
