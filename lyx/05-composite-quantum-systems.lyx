\begin_layout Plain Layout

\series bold
Exercise 5.2
\end_layout

\begin_layout Plain Layout
The Kronecker product with vectors.
\end_layout

\begin_layout Enumerate
Take the Kronecker product of the two vectors
\begin_inset Formula 
\[
\ket{\psi}_{0}=\left[\begin{array}{c}
c_{0}\\
c_{1}
\end{array}\right],\qquad\ket{\psi}_{1}=\left[\begin{array}{c}
d_{0}\\
d_{1}
\end{array}\right]\;.
\]

\end_inset

#+html:
 <details><summary>Show/hide solution...</summary>
\begin_inset Formula 
\begin{equation}
\ket{\psi}_{1}\otimes\ket{\psi}_{0}=\left[\begin{array}{c}
d_{0}\left[\begin{array}{c}
c_{0}\\
c_{1}
\end{array}\right]\\
d_{1}\left[\begin{array}{c}
c_{0}\\
c_{1}
\end{array}\right]
\end{array}\right]=\left[\begin{array}{c}
d_{0}c_{0}\\
d_{0}c_{1}\\
d_{1}c_{0}\\
d_{1}c_{1}
\end{array}\right]\begin{array}{c}
\leftrightarrow\ket{0}\ket{0}\\
\leftrightarrow\ket{0}\ket{1}\\
\leftrightarrow\ket{1}\ket{0}\\
\leftrightarrow\ket{1}\ket{1}
\end{array}\label{eq:TwoQubitVectorKron}
\end{equation}

\end_inset

Notice that Equation (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:TwoQubitVectorKron"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) agrees with our result from (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:TwoQubitColVector"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

).
\begin_inset Newline newline
\end_inset

#+html:
 </details>
\end_layout

\begin_layout Enumerate
Take the three-Cbit Kronecker product 
\begin_inset Formula $\ket{2}_{3}=\ket{0}\otimes\ket{1}\otimes\ket{0}$
\end_inset

:
\begin_inset Newline newline
\end_inset

#+html:
 <details><summary>Show/hide solution...</summary>
\begin_inset Newline newline
\end_inset


\begin_inset Formula 
\[
\ket{0}\otimes\ket{1}\otimes\ket{0}=\left[\begin{array}{c}
1\\
0
\end{array}\right]\otimes\left[\begin{array}{c}
0\\
1
\end{array}\right]\otimes\left[\begin{array}{c}
1\\
0
\end{array}\right]=\left[\begin{array}{c}
1\\
0
\end{array}\right]\otimes\left[\begin{array}{c}
0\\
0\\
1\\
0
\end{array}\right]=\left[\begin{array}{c}
0\\
0\\
1\\
0\\
0\\
0\\
0\\
0
\end{array}\right]\begin{array}{c}
\leftrightarrow\ket{000}\\
\leftrightarrow\ket{001}\\
\leftrightarrow\ket{010}\\
\leftrightarrow\ket{011}\\
\leftrightarrow\ket{100}\\
\leftrightarrow\ket{101}\\
\leftrightarrow\ket{110}\\
\leftrightarrow\ket{111}
\end{array}
\]

\end_inset

#+html:
 </details>
\end_layout

