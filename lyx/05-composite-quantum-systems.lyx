\end_layout

\end_inset


\end_layout

\begin_layout Itemize
Observations
\end_layout

\begin_deeper
\begin_layout Itemize
If we number the bits in the eight-element vector 0 through 7,
 then only element 2 is unity,
 and all others are zero.
\end_layout

\end_deeper
\begin_layout Itemize
This works for any 
\begin_inset Formula $N$
\end_inset

-bit system.
\end_layout

\begin_deeper
\begin_layout Itemize
If we compose the appropriate Cbits 
\begin_inset Formula 
\[
\ket{b_{N-1}}\ket{b_{N-2}}\cdots\ket{b_{1}}\ket{b_{0}}=\ket{k}_{N},
\]

\end_inset

then in the corresponding vector,
 the 
\begin_inset Formula $k^{\mbox{{\tiny {th}}}}$
\end_inset

 element alone is unity,
 and all others are zero.
\end_layout

\end_deeper
\begin_layout Itemize
Conversely,
 we can:
\end_layout

\begin_deeper
\begin_layout Itemize
Represent 
\begin_inset Formula $S$
\end_inset

 different numbers over 
\begin_inset Formula $0\leq k<S$
\end_inset

 using an 
\begin_inset Formula $S$
\end_inset

-element vector 
\begin_inset Formula $\ket{k}$
\end_inset


\end_layout

\begin_layout Itemize
The 
\begin_inset Formula $k^{\mbox{{\tiny {th}}}}$
\end_inset

 number is represented by setting element 
\begin_inset Formula $k=1$
\end_inset

,
 and all other elements to zero
\end_layout

\end_deeper
\begin_layout Section
Product States and Entangled States
\end_layout

\begin_layout Itemize
Consider a state two-qubit state
\begin_inset Formula 
\[
\Ket{\Psi}=\ket{\psi_{B}}\otimes\ket{\psi_{A}}.
\]

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
Here,
 the qubits are labeled 
\begin_inset Formula $A$
\end_inset

 and 
\begin_inset Formula $B$
\end_inset

,
 and we have ordered them to suggest that qubit 
\begin_inset Formula $A$
\end_inset

 is the least-significant bit,
 and qubit 
\begin_inset Formula $B$
\end_inset

 is the most-significant bit
\end_layout

\begin_layout Itemize
By definition,
 
\begin_inset Formula $\ket{\Psi}$
\end_inset

 is a product state,
 because it can be formed by a tensor product of subsystem quantum states.
\end_layout

\begin_layout Itemize
We are ignoring the physical implementation of the qubits,
 since there are numerous ways to implement a qubit.
 We simply need a two-state system,
 and we assign 
\begin_inset Quotes eld
\end_inset

0
\begin_inset Quotes erd
\end_inset

 to one state,
 and 
\begin_inset Quotes eld
\end_inset

1
\begin_inset Quotes erd
\end_inset

 to the other state:
\end_layout

\begin_deeper
\begin_layout Itemize
Polarization of light:
 
\begin_inset Formula $\left\{ \leftrightarrow,\updownarrow\right\} $
\end_inset

,
\begin_inset Formula $\left\{ \circlearrowright,\circlearrowleft\right\} $
\end_inset


\end_layout

\begin_layout Itemize
Electronic spin:
 
\begin_inset Formula $\left\{ \uparrow,\downarrow\right\} $
\end_inset


\end_layout

\begin_layout Itemize
Electronic location:
 
\begin_inset Formula $\left\{ \ket{L},\ket{R}\right\} $
\end_inset


\end_layout

\begin_layout Itemize
Eigenstates of a QHO,
 using only the ground state and the first excited state:
 
\begin_inset Formula $\left\{ \ket{0},\ket{1}\right\} $
\end_inset


\end_layout

\end_deeper
\end_deeper
\begin_layout Itemize
Let 
\begin_inset Formula $\ket{\psi_{A}}=a_{0}\ket{0_{A}}+a_{1}\ket{1_{A}}$
\end_inset

,
 and 
\begin_inset Formula $\ket{\psi_{B}}=b_{0}\ket{0_{B}}+b_{1}\ket{1_{B}}$
\end_inset

.
 Then,
\begin_inset Newline newline
\end_inset


\begin_inset Formula 
\begin{align*}
\ket{\Psi} & =\ket{\psi_{A}}\otimes\ket{\psi_{B}}=\ket{\psi_{B}}\otimes\ket{\psi_{A}}\\
 & =b_{0}a_{0}\ket{0_{B}}\ket{0_{A}}+b_{0}a_{1}\ket{0_{B}}\ket{1_{A}}+b_{1}a_{0}\ket{1_{B}}\ket{0_{A}}+b_{1}a_{1}\ket{1_{B}}\ket{1_{A}}.\\
 & =b_{0}a_{0}\ket{0_{B}0_{A}}+b_{0}a_{1}\ket{0_{B}1_{A}}+b_{1}a_{0}\ket{1_{B}0_{A}}+b_{1}a_{1}\ket{1_{B}1_{A}}.
\end{align*}

\end_inset


\end_layout

\begin_layout Itemize
In quantum computing literature,
 it is customary to drop the subscripts inside the kets and simply write
\begin_inset Newline newline
\end_inset


\begin_inset Formula 
\begin{equation}
\ket{\Psi}=b_{0}a_{0}\ket{00}+b_{0}a_{1}\ket{01}+b_{1}a_{0}\ket{10}+b_{1}a_{1}\ket{11}.\label{eq:ProductState}
\end{equation}

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
We have associated the position of each bit with a quantum subsystem
\end_layout

\begin_layout Itemize
It is important that we are consistent with these associations when using the more compact notation
\end_layout

\end_deeper
\begin_layout Itemize
More generally,
 we could write a two-qubit state
\begin_inset Formula 
\begin{align*}
\ket{\Psi} & =c_{0}\ket{00}+c_{1}\ket{01}+c_{2}\ket{10}+c_{3}\ket{11}\\
 & =c_{0}\ket{0_{2}}+c_{1}\ket{1_{2}}+c_{2}\ket{2_{2}}+c_{3}\ket{3_{2}}.
\end{align*}

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
This introduces another shorthand notation,
 where we:
\end_layout

\begin_deeper
\begin_layout Itemize
write the base-10 equivalent integer 
\begin_inset Formula $d_{N}$
\end_inset

 of the 
\begin_inset Formula $N$
\end_inset

-bit string 
\begin_inset Formula $q_{N-1}q_{N-2}\cdots q_{1}q_{0}$
\end_inset

,
 and
\end_layout

\begin_layout Itemize
and use a subscript 
\begin_inset Formula $N$
\end_inset

 to indicate that 
\begin_inset Formula $d_{N}$
\end_inset

 indexes a 
\begin_inset Formula $N$
\end_inset

-qubit state
\end_layout

\end_deeper
\end_deeper
