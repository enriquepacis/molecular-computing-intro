\begin_layout Itemize
The state
\begin_inset Formula 
\[
\ket{\Phi^{\pm}}=\frac{1}{\sqrt{2}}\left(\ket{00}\pm\ket{11}\right)
\]

\end_inset

and the states
\begin_inset Formula 
\[
\ket{\Psi^{\pm}}=\frac{1}{\sqrt{2}}\left(\ket{01}\pm\ket{10}\right)
\]

\end_inset

are two-qubit states of maximal entanglement.
\end_layout

